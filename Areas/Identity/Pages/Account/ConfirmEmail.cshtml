@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email confirmed";
}

<section class="auth-page portal-surface" aria-labelledby="email-confirmed-title">
    <div class="site-shell auth-page__shell">
        <header class="auth-page__header reveal">
            <p class="eyebrow eyebrow--light">Account activated</p>
            <h1 id="email-confirmed-title">You are all set</h1>
            <p>Your Campus Coffee account is ready to use.</p>
        </header>

        <div class="auth-page__form-wrap reveal">
            <div class="product-card auth-card">
                <div class="product-card__body auth-card__body auth-message">
                    <p class="auth-status @(Model.Succeeded ? "" : "is-error")">@Model.StatusMessage</p>
                    <a class="button product-card__button" asp-area="" asp-controller="Home" asp-action="CustomerLogin">Sign in</a>
                </div>
            </div>
        </div>
    </div>
</section>
