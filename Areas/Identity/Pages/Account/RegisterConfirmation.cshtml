@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Check your inbox";
}

<section class="auth-page portal-surface" aria-labelledby="confirmation-title">
    <div class="site-shell auth-page__shell">
        <header class="auth-page__header reveal">
            <p class="eyebrow eyebrow--light">One last step</p>
            <h1 id="confirmation-title">Check your inbox</h1>
            <p>We have sent a confirmation link to <strong>@Model.Email</strong>.</p>
        </header>

        <div class="auth-page__form-wrap reveal">
            <div class="product-card auth-card">
                <div class="product-card__body auth-card__body auth-message">
                    <p>Open the email and select the confirmation link to activate your account. You can then sign in and start ordering.</p>
                    <a class="button product-card__button" asp-area="" asp-controller="Home" asp-action="CustomerLogin">Back to sign in</a>
                </div>
            </div>
        </div>
    </div>
</section>
