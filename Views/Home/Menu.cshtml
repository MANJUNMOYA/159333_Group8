@{
    ViewData["Title"] = "Menu";
}

<section class="menu-hero page-hero--animated" data-video-hero aria-labelledby="menu-title">
    <video class="page-hero__video" data-hero-video autoplay muted loop playsinline preload="auto"
           poster="@Url.Content("~/images/home/coffee-hero-top-view.jpg")" aria-hidden="true" tabindex="-1">
        <source src="@Url.Content("~/videos/menuvideo.mp4")" type="video/mp4" />
    </video>
    <div class="menu-hero__shade page-hero__overlay"></div>
    <div class="site-shell menu-hero__content page-hero__copy">
        <p class="eyebrow eyebrow--light">Made fresh on campus</p>
        <h1 id="menu-title">Find your<br />favourite.</h1>
        <p>Good coffee, honest food and something for every kind of campus day.</p>
    </div>
</section>

<div class="promise-strip" aria-label="Menu highlights">
    <div class="promise-strip__track">
        <span>Freshly made</span><i></i><span>Plant-based choices</span><i></i><span>Campus pickup</span><i></i><span>Made for your day</span><i></i>
    </div>
</div>

<section class="menu-catalog" data-menu-catalog>
    <div class="site-shell">
        <div class="menu-tools reveal">
            <div class="menu-search">
                <label for="menu-search">Search the menu</label>
                <div class="menu-search__field">
                    <span aria-hidden="true">⌕</span>
                    <input id="menu-search" type="search" placeholder="Search coffee or food" autocomplete="off" data-menu-search />
                </div>
            </div>

            <fieldset class="menu-filters">
                <legend>Filter by category</legend>
                <div class="menu-filters__buttons">
                    <button class="menu-filter is-active" type="button" data-menu-filter="all" aria-pressed="true">All</button>
                    <button class="menu-filter" type="button" data-menu-filter="coffee" aria-pressed="false">Coffee</button>
                    <button class="menu-filter" type="button" data-menu-filter="food" aria-pressed="false">Food</button>
                </div>
            </fieldset>

            <p class="menu-results" data-menu-results aria-live="polite">Showing 6 of 12 items</p>
        </div>

        <div class="menu-empty" data-menu-empty hidden>
            <p class="eyebrow">Nothing found</p>
            <h2>No menu items match that search.</h2>
            <p>Try another name or choose a different category.</p>
        </div>

        <section class="menu-group" data-menu-section="coffee" aria-labelledby="coffee-heading">
            <div class="menu-group__heading reveal">
                <div>
                    <p class="eyebrow">Your daily ritual</p>
                    <h2 id="coffee-heading">Coffee</h2>
                </div>
                <p>Carefully made, from the first morning lecture to the last afternoon catch-up.</p>
            </div>

            <div class="product-grid">
                <article class="product-card reveal" data-menu-card data-category="coffee" data-order="1" data-name="Campus Flat White">
                    <div class="product-card__image">
                        <img src="~/images/menu/Campus Flat White.jpg" alt="Flat white with leaf art in a ceramic cup" />
                        <span class="product-card__category">Coffee</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Campus Flat White</h3>
                            <span class="product-card__price">NZ$4.80</span>
                        </div>
                        <p class="product-card__description">Double espresso finished with smooth, velvety steamed milk.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegetarian">Vegetarian</span>
                            <span class="dietary-badge dietary-badge--allergy">Contains milk</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock"><span aria-hidden="true"></span>In stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="coffee" data-order="3" data-name="Long Black">
                    <div class="product-card__image">
                        <img src="~/images/menu/Long Black.jpg" alt="Fresh long black coffee on a café table" />
                        <span class="product-card__category">Coffee</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Long Black</h3>
                            <span class="product-card__price">NZ$4.20</span>
                        </div>
                        <p class="product-card__description">Rich double espresso poured over hot water for a clean finish.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegan">Vegan</span>
                            <span class="dietary-badge dietary-badge--allergy">No major allergens</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock"><span aria-hidden="true"></span>In stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="coffee" data-order="5" data-name="Iced Oat Latte">
                    <div class="product-card__image">
                        <img src="~/images/menu/Iced Oat Latte.jpg" alt="Iced oat latte in a tall glass" />
                        <span class="product-card__category">Cold coffee</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Iced Oat Latte</h3>
                            <span class="product-card__price">NZ$5.80</span>
                        </div>
                        <p class="product-card__description">Espresso, chilled oat milk and ice for an easy campus pick-me-up.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegan">Vegan</span>
                            <span class="dietary-badge dietary-badge--allergy">Contains oats</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock"><span aria-hidden="true"></span>In stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="coffee" data-order="7" data-name="Dark Chocolate Mocha">
                    <div class="product-card__image">
                        <img src="~/images/menu/Dark Chocolate Mocha.jpg" alt="Dark chocolate mocha being prepared" />
                        <span class="product-card__category">Coffee</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Dark Chocolate Mocha</h3>
                            <span class="product-card__price">NZ$5.60</span>
                        </div>
                        <p class="product-card__description">Espresso and dark cocoa balanced with silky steamed milk.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegetarian">Vegetarian</span>
                            <span class="dietary-badge dietary-badge--allergy">Contains milk</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock product-card__stock--low"><span aria-hidden="true"></span>Low stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="coffee" data-order="9" data-name="Vanilla Cold Brew">
                    <div class="product-card__image">
                        <img src="~/images/menu/Vanilla Cold Brew.jpg" alt="Cold brew coffee viewed from above" />
                        <span class="product-card__category">Cold coffee</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Vanilla Cold Brew</h3>
                            <span class="product-card__price">NZ$5.40</span>
                        </div>
                        <p class="product-card__description">Slow-steeped coffee with a light touch of house vanilla.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegan">Vegan</span>
                            <span class="dietary-badge dietary-badge--allergy">No major allergens</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock"><span aria-hidden="true"></span>In stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="coffee" data-order="11" data-name="Maple Cinnamon Latte">
                    <div class="product-card__image">
                        <img src="~/images/menu/Maple Cinnamon Latte.jpg" alt="Maple cinnamon latte beside a pastry" />
                        <span class="product-card__category">Seasonal coffee</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Maple Cinnamon Latte</h3>
                            <span class="product-card__price">NZ$5.90</span>
                        </div>
                        <p class="product-card__description">A warming espresso with maple, cinnamon and steamed milk.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegetarian">Vegetarian</span>
                            <span class="dietary-badge dietary-badge--allergy">Contains milk</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock product-card__stock--unavailable"><span aria-hidden="true"></span>Sold out</p>
                            <button class="button product-card__button" type="button" disabled>Sold out</button>
                        </div>
                    </div>
                </article>
            </div>

            <nav class="menu-pagination" aria-label="Coffee pagination" data-menu-pagination="coffee">
                <button class="menu-pagination__direction" type="button" data-page-previous aria-label="Previous Coffee page">← Previous</button>
                <div class="menu-pagination__pages" data-page-numbers></div>
                <button class="menu-pagination__direction" type="button" data-page-next aria-label="Next Coffee page">Next →</button>
            </nav>
        </section>

        <section class="menu-group" data-menu-section="food" aria-labelledby="food-heading">
            <div class="menu-group__heading reveal">
                <div>
                    <p class="eyebrow">From the kitchen</p>
                    <h2 id="food-heading">Food</h2>
                </div>
                <p>Simple, satisfying food made for breakfast breaks, quick lunches and everything between.</p>
            </div>

            <div class="product-grid">
                <article class="product-card reveal" data-menu-card data-category="food" data-order="2" data-name="Butter Croissant">
                    <div class="product-card__image">
                        <img src="~/images/menu/Butter Croissant.jpg" alt="Freshly baked butter croissant beside coffee" />
                        <span class="product-card__category">Bakery</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Butter Croissant</h3>
                            <span class="product-card__price">NZ$4.90</span>
                        </div>
                        <p class="product-card__description">Flaky, golden and baked fresh for an easy morning start.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegetarian">Vegetarian</span>
                            <span class="dietary-badge dietary-badge--allergy">Gluten · Milk · Egg</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock"><span aria-hidden="true"></span>In stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="food" data-order="4" data-name="Roast Vegetable Focaccia">
                    <div class="product-card__image">
                        <img src="~/images/menu/Roast Vegetable Focaccia.jpg" alt="Roast vegetable focaccia with fresh greens" />
                        <span class="product-card__category">Lunch</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Roast Vegetable Focaccia</h3>
                            <span class="product-card__price">NZ$9.80</span>
                        </div>
                        <p class="product-card__description">Roasted seasonal vegetables, greens and herb dressing in focaccia.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegan">Vegan</span>
                            <span class="dietary-badge dietary-badge--allergy">Contains gluten</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock"><span aria-hidden="true"></span>In stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="food" data-order="6" data-name="Egg and Spinach Brioche">
                    <div class="product-card__image">
                        <img src="~/images/menu/Egg Spinach Brioche.jpg" alt="Egg and spinach brioche ready for a campus breakfast" />
                        <span class="product-card__category">Breakfast</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Egg &amp; Spinach Brioche</h3>
                            <span class="product-card__price">NZ$10.50</span>
                        </div>
                        <p class="product-card__description">Free-range egg, baby spinach and cheddar in a toasted brioche bun.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegetarian">Vegetarian</span>
                            <span class="dietary-badge dietary-badge--allergy">Gluten · Milk · Egg</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock product-card__stock--low"><span aria-hidden="true"></span>Low stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="food" data-order="8" data-name="Banana Walnut Loaf">
                    <div class="product-card__image">
                        <img src="~/images/menu/Banana Walnut Loaf.jpg" alt="Slice of banana walnut loaf" />
                        <span class="product-card__category">Bakery</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Banana Walnut Loaf</h3>
                            <span class="product-card__price">NZ$5.50</span>
                        </div>
                        <p class="product-card__description">A generous slice of soft banana loaf finished with toasted walnuts.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegetarian">Vegetarian</span>
                            <span class="dietary-badge dietary-badge--allergy">Gluten · Egg · Nuts</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock"><span aria-hidden="true"></span>In stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="food" data-order="10" data-name="Garden Salad Bowl">
                    <div class="product-card__image">
                        <img src="~/images/menu/Garden Salad Bowl.jpg" alt="Fresh garden salad bowl for lunch" />
                        <span class="product-card__category">Lunch</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Garden Salad Bowl</h3>
                            <span class="product-card__price">NZ$11.20</span>
                        </div>
                        <p class="product-card__description">Seasonal greens, roast vegetables, seeds and lemon herb dressing.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegan">Vegan</span>
                            <span class="dietary-badge dietary-badge--allergy">Contains sesame</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock"><span aria-hidden="true"></span>In stock</p>
                            <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                        </div>
                    </div>
                </article>

                <article class="product-card reveal" data-menu-card data-category="food" data-order="12" data-name="Mushroom and Thyme Toastie">
                    <div class="product-card__image">
                        <img src="~/images/menu/Mushroom Thyme Toastie.jpg" alt="Toasted mushroom and thyme sandwich" />
                        <span class="product-card__category">Lunch</span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Mushroom &amp; Thyme Toastie</h3>
                            <span class="product-card__price">NZ$10.80</span>
                        </div>
                        <p class="product-card__description">Roasted mushrooms, thyme and cheddar pressed until crisp and golden.</p>
                        <div class="product-card__badges" aria-label="Dietary and allergy information">
                            <span class="dietary-badge dietary-badge--vegetarian">Vegetarian</span>
                            <span class="dietary-badge dietary-badge--allergy">Gluten · Milk</span>
                        </div>
                        <div class="product-card__footer">
                            <p class="product-card__stock product-card__stock--unavailable"><span aria-hidden="true"></span>Sold out</p>
                            <button class="button product-card__button" type="button" disabled>Sold out</button>
                        </div>
                    </div>
                </article>
            </div>

            <nav class="menu-pagination" aria-label="Food pagination" data-menu-pagination="food">
                <button class="menu-pagination__direction" type="button" data-page-previous aria-label="Previous Food page">← Previous</button>
                <div class="menu-pagination__pages" data-page-numbers></div>
                <button class="menu-pagination__direction" type="button" data-page-next aria-label="Next Food page">Next →</button>
            </nav>
        </section>
    </div>

    <p class="visually-hidden" data-cart-status aria-live="polite"></p>
</section>

<section class="menu-closing">
    <div class="site-shell menu-closing__inner reveal">
        <div>
            <p class="eyebrow eyebrow--light">Good to know</p>
            <h2>Made fresh, every weekday.</h2>
        </div>
        <p>Our menu changes with the season. Ask our team about ingredient substitutions or dietary needs before ordering.</p>
    </div>
</section>
