@model CampusCoffeeSystem.Models.MenuViewModel
@{
    ViewData["Title"] = "Menu";
    var categories = new[] { "coffee", "food" };
}

<section class="menu-hero page-hero--animated" data-video-hero aria-labelledby="menu-title">
    <video class="page-hero__video" data-hero-video autoplay muted loop playsinline preload="auto"
           poster="@Url.Content("~/images/home/coffee-hero-top-view.jpg")" aria-hidden="true" tabindex="-1">
        <source src="@Url.Content("~/videos/menuvideo.mp4")" type="video/mp4" />
    </video>
    <div class="menu-hero__shade page-hero__overlay"></div>
    <div class="site-shell menu-hero__content page-hero__copy">
        <p class="eyebrow eyebrow--light">Made fresh on campus</p>
        <h1 id="menu-title">Find your<br />favourite.</h1>
        <p>Good coffee, honest food and something for every kind of campus day.</p>
    </div>
</section>

<div class="promise-strip" aria-label="Menu highlights">
    <div class="promise-strip__track">
        <span>Freshly made</span><i></i><span>Plant-based choices</span><i></i><span>Campus pickup</span><i></i><span>Made for your day</span><i></i>
    </div>
</div>

<section class="menu-catalog" data-menu-catalog>
    <div class="site-shell">
        <div class="menu-tools reveal">
            <div class="menu-search">
                <label for="menu-search">Search the menu</label>
                <div class="menu-search__field">
                    <span aria-hidden="true">⌕</span>
                    <input id="menu-search" type="search" placeholder="Search coffee or food" autocomplete="off" data-menu-search />
                </div>
            </div>
            <fieldset class="menu-filters">
                <legend>Filter by category</legend>
                <div class="menu-filters__buttons">
                    <button class="menu-filter is-active" type="button" data-menu-filter="all" aria-pressed="true">All</button>
                    <button class="menu-filter" type="button" data-menu-filter="coffee" aria-pressed="false">Coffee</button>
                    <button class="menu-filter" type="button" data-menu-filter="food" aria-pressed="false">Food</button>
                </div>
            </fieldset>
            <p class="menu-results" data-menu-results aria-live="polite">Showing @Model.Products.Count available items</p>
        </div>

        <div class="menu-empty" data-menu-empty hidden>
            <p class="eyebrow">Nothing found</p>
            <h2>No menu items match that search.</h2>
            <p>Try another name or choose a different category.</p>
        </div>

        @foreach (var category in categories)
        {
            var products = Model.Products.Where(product => product.Category == category).ToList();
            var isCoffee = category == "coffee";
            <section class="menu-group" data-menu-section="@category" aria-labelledby="@category-heading">
                <div class="menu-group__heading reveal">
                    <div>
                        <p class="eyebrow">@(isCoffee ? "Your daily ritual" : "From the kitchen")</p>
                        <h2 id="@category-heading">@(isCoffee ? "Coffee" : "Food")</h2>
                    </div>
                    <p>@(isCoffee
                        ? "Carefully made, from the first morning lecture to the last afternoon catch-up."
                        : "Simple, satisfying food made for breakfast breaks, quick lunches and everything between.")</p>
                </div>

                <div class="product-grid">
                    @foreach (var product in products)
                    {
                        var stockLabel = product.StockQuantity == 0 ? "Sold out" : product.StockQuantity <= 8 ? "Low stock" : "In stock";
                        var stockClass = product.StockQuantity == 0 ? "product-card__stock--unavailable" : product.StockQuantity <= 8 ? "product-card__stock--low" : string.Empty;
                        var rating = Model.Ratings[product.Id];
                        <article class="product-card reveal" data-menu-card data-product-id="@product.Id" data-category="@product.Category" data-order="@product.SortOrder" data-name="@product.Name">
                            <div class="product-card__image">
                                <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@product.Id" aria-label="View @product.Name">
                                    <img src="@product.ImagePath" alt="@product.Name" />
                                </a>
                                <span class="product-card__category">@product.DisplayCategory</span>
                            </div>
                            <div class="product-card__body">
                                <div class="product-card__heading">
                                    <h3>@product.Name</h3>
                                    <span class="product-card__price">@CurrencyFormatter.NzDollars(product.Price)</span>
                                </div>
                                <p class="product-card__rating" aria-label="@ReviewDisplay.Rating(rating.AverageRating) out of 5 from @rating.ReviewCount reviews">
                                    <span aria-hidden="true">@ReviewDisplay.Stars(rating.AverageRating)</span>
                                    @if (rating.ReviewCount > 0)
                                    {
                                        <strong>@ReviewDisplay.Rating(rating.AverageRating)</strong><span>(@rating.ReviewCount)</span>
                                    }
                                    else
                                    {
                                        <span>No reviews yet</span>
                                    }
                                </p>
                                <p class="product-card__description">@product.Description</p>
                                <div class="product-card__badges" aria-label="Dietary and allergy information">
                                    @if (!string.IsNullOrWhiteSpace(product.DietaryLabel))
                                    {
                                        <span class="dietary-badge dietary-badge--@product.DietaryCssClass">@product.DietaryLabel</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(product.AllergenLabel))
                                    {
                                        <span class="dietary-badge dietary-badge--allergy">@product.AllergenLabel</span>
                                    }
                                </div>
                                <div class="product-card__footer">
                                    <p class="product-card__stock @stockClass"><span aria-hidden="true"></span>@stockLabel</p>
                                    @if (product.StockQuantity > 0)
                                    {
                                        <button class="button product-card__button" type="button" data-add-to-cart>Add to cart</button>
                                    }
                                    else
                                    {
                                        <button class="button product-card__button" type="button" disabled>Sold out</button>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <nav class="menu-pagination" aria-label="@(isCoffee ? "Coffee" : "Food") pagination" data-menu-pagination="@category">
                    <button class="menu-pagination__direction" type="button" data-page-previous>← Previous</button>
                    <div class="menu-pagination__pages" data-page-numbers></div>
                    <button class="menu-pagination__direction" type="button" data-page-next>Next →</button>
                </nav>
            </section>
        }
    </div>
    <p class="visually-hidden" data-cart-status aria-live="polite"></p>
</section>

<section class="menu-closing">
    <div class="site-shell menu-closing__inner reveal">
        <div><p class="eyebrow eyebrow--light">Good to know</p><h2>Made fresh, every weekday.</h2></div>
        <p>Our menu changes with the season. Ask our team about ingredient substitutions or dietary needs before ordering.</p>
    </div>
</section>
