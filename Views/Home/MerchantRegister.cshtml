@{
    ViewData["Title"] = "Merchant Registration";
}

<section class="our-story-hero" aria-labelledby="merchant-register-title">
    <div class="site-shell reveal">
        <p class="eyebrow eyebrow--light">Merchant Access</p>
        <h1 id="merchant-register-title">Join as a Merchant</h1>
        <p class="our-story-hero__subtitle">Prepare your Campus Coffee merchant profile.</p>
    </div>
</section>

<section class="menu-catalog">
    <div class="site-shell">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-7">
                <div class="product-card reveal">
                    <div class="product-card__body">
                        <div class="product-card__heading mb-4"><h2>Merchant Registration</h2></div>
                        <form data-placeholder-auth data-auth-label="Merchant registration">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="form-label cart-item__label" for="merchant-register-business">Business Name</label>
                                    <input class="form-control form-control-lg rounded-0" id="merchant-register-business" type="text" autocomplete="organization" placeholder="Business name" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label cart-item__label" for="merchant-register-contact">Contact Name</label>
                                    <input class="form-control form-control-lg rounded-0" id="merchant-register-contact" type="text" autocomplete="name" placeholder="Contact person" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label cart-item__label" for="merchant-register-email">Business Email</label>
                                    <input class="form-control form-control-lg rounded-0" id="merchant-register-email" type="email" autocomplete="email" placeholder="merchant@example.com" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label cart-item__label" for="merchant-register-password">Password</label>
                                    <input class="form-control form-control-lg rounded-0" id="merchant-register-password" type="password" autocomplete="new-password" placeholder="Create a password" required />
                                </div>
                            </div>
                            <button class="button product-card__button w-100 mt-4" type="submit">Create Merchant Account</button>
                            <p class="mt-4 mb-0 text-center">Already registered? <a class="text-link" asp-area="" asp-controller="Home" asp-action="MerchantLogin">Sign In</a></p>
                            <p class="menu-note mt-4" data-auth-status aria-live="polite" hidden></p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
