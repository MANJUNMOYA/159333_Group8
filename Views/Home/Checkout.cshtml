@model CampusCoffeeSystem.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<section class="menu-hero">
    <div class="menu-hero__shade" aria-hidden="true"></div>
    <div class="site-shell menu-hero__content reveal">
        <p class="eyebrow">Campus Coffee Checkout</p>
        <h1>Almost there.</h1>
        <p class="menu-hero__copy">
            Confirm your details and choose how you would like to receive your order.
        </p>
    </div>
</section>

<section class="menu-catalog" data-checkout data-order-confirmation-url="@Url.Action("OrderConfirmation", "Home")">
    <div class="site-shell">
        <div class="row g-4 g-xl-5 align-items-start">
            <div class="col-xl-8">
                <div class="product-card reveal">
                    <div class="product-card__body">
                        <div class="product-card__heading mb-4">
                            <p class="eyebrow">Your Details</p>
                            <h2>Customer Information</h2>
                        </div>

                        <form id="checkout-form" data-checkout-form>
                            @Html.AntiForgeryToken()
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="form-label cart-item__label" for="customerName">Name</label>
                                    <input class="form-control form-control-lg rounded-0" id="customerName" name="name" type="text"
                                           value="@Model.Name" placeholder="Alex Taylor" autocomplete="name" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label cart-item__label" for="customerEmail">Email</label>
                                    <input class="form-control form-control-lg rounded-0" id="customerEmail" name="email" type="email"
                                           value="@Model.Email" placeholder="alex@example.com" autocomplete="email" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label cart-item__label" for="customerPhone">Phone Number</label>
                                    <input class="form-control form-control-lg rounded-0" id="customerPhone" name="phone" type="tel"
                                           value="@Model.Phone" placeholder="021 234 5678" autocomplete="tel" required />
                                </div>

                                <div class="col-12">
                                    <fieldset>
                                        <legend class="cart-item__label mb-3">Pickup or Delivery</legend>
                                        <div class="d-flex flex-column flex-sm-row gap-3">
                                            <label class="menu-filter is-active d-flex align-items-center justify-content-center gap-2">
                                                <input class="form-check-input m-0" type="radio" name="orderMethod" value="Pickup" checked />
                                                Pickup
                                            </label>
                                            <label class="menu-filter d-flex align-items-center justify-content-center gap-2">
                                                <input class="form-check-input m-0" type="radio" name="orderMethod" value="Delivery" />
                                                Delivery
                                            </label>
                                        </div>
                                    </fieldset>
                                </div>

                                <div class="col-12 checkout-delivery-address" data-delivery-address hidden>
                                    <div class="product-card__heading mb-4">
                                        <div>
                                            <p class="eyebrow">Delivery details</p>
                                            <h3>Where should we deliver?</h3>
                                        </div>
                                    </div>
                                    <div class="row g-4">
                                        <div class="col-12">
                                            <label class="form-label cart-item__label" for="addressLine1">Address Line 1</label>
                                            <input class="form-control form-control-lg rounded-0" id="addressLine1" name="addressLine1" type="text" value="@Model.AddressLine1" maxlength="200" autocomplete="address-line1" data-delivery-required />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label cart-item__label" for="addressLine2">Address Line 2 <span>(optional)</span></label>
                                            <input class="form-control form-control-lg rounded-0" id="addressLine2" name="addressLine2" type="text" value="@Model.AddressLine2" maxlength="200" autocomplete="address-line2" />
                                        </div>
                                        <div class="col-md-7">
                                            <label class="form-label cart-item__label" for="deliveryCity">City</label>
                                            <input class="form-control form-control-lg rounded-0" id="deliveryCity" name="city" type="text" value="@Model.City" maxlength="100" autocomplete="address-level2" data-delivery-required />
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label cart-item__label" for="deliveryPostcode">Postcode</label>
                                            <input class="form-control form-control-lg rounded-0" id="deliveryPostcode" name="postcode" type="text" value="@Model.Postcode" maxlength="20" autocomplete="postal-code" pattern="[A-Za-z0-9][A-Za-z0-9 \-]{1,19}" data-delivery-required />
                                        </div>
                                    </div>

                                    @if (Model.IsAuthenticatedCustomer && Model.HasSavedDeliveryAddress)
                                    {
                                        <label class="checkout-save-address mt-4">
                                            <input class="form-check-input" type="checkbox" name="saveDeliveryAddressAsDefault" value="true" />
                                            <span>Save this as my default delivery address</span>
                                        </label>
                                    }
                                    else if (Model.IsAuthenticatedCustomer)
                                    {
                                        <p class="checkout-address-note mt-4">Your first delivery address will be saved automatically to your Profile.</p>
                                    }
                                </div>

                                <div class="col-12">
                                    <label class="form-label cart-item__label" for="specialNotes">Special Notes</label>
                                    <textarea class="form-control rounded-0" id="specialNotes" name="specialNotes" rows="5"
                                              placeholder="Add dietary requests, delivery instructions, or anything else we should know."></textarea>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <aside class="product-card reveal">
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <p class="eyebrow">Your Order</p>
                            <h2>Order Summary</h2>
                        </div>

                        <div data-checkout-items hidden></div>

                        <div class="menu-note mt-4" data-checkout-empty hidden>
                            <strong>Your cart is empty.</strong>
                            <span>Add something from the menu when you are ready.</span>
                        </div>

                        <template data-checkout-item-template>
                            <div class="menu-note mt-0" data-checkout-item>
                                <div>
                                    <strong class="d-block" data-checkout-name></strong>
                                    <span data-checkout-details></span>
                                </div>
                                <div class="text-xl-end">
                                    <span class="cart-item__label d-block">Subtotal</span>
                                    <strong class="d-block" data-checkout-item-subtotal></strong>
                                </div>
                            </div>
                        </template>

                        <div class="pt-4">
                            <div class="d-flex justify-content-between mb-3">
                                <span>Subtotal</span>
                                <strong data-checkout-subtotal>NZ$0.00</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span>Delivery Fee</span>
                                <strong data-checkout-delivery>NZ$0.00</strong>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between align-items-center fs-5">
                                <strong>Total</strong>
                                <strong data-checkout-total>NZ$0.00</strong>
                            </div>
                        </div>

                        <button class="button product-card__button w-100 mt-4" type="submit" form="checkout-form" data-place-order disabled>Place Order</button>
                        <p class="auth-status mt-3" data-order-status aria-live="polite"></p>
                        <a class="text-link justify-content-center mt-4" asp-controller="Home" asp-action="Menu">
                            Continue Shopping <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>
