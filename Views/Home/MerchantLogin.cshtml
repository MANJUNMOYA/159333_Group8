@{
    ViewData["Title"] = "Merchant Login";
}

<section class="menu-closing portal-surface" aria-label="Merchant Login">
    <div class="site-shell pt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-6">
                <div class="product-card auth-card reveal">
                    <div class="product-card__body">
                        <div class="product-card__heading auth-card__heading mb-4"><h3>Sign in as a merchant</h3></div>
                        <form data-auth-login data-role="merchant" data-redirect-url="@Url.Action("MerchantDashboard", "Home")">
                            @Html.AntiForgeryToken()
                            <div class="mb-4">
                                <label class="form-label cart-item__label" for="merchant-login-email">Business Email</label>
                                <input class="form-control form-control-lg rounded-0" id="merchant-login-email" name="identifier" type="email" autocomplete="email" placeholder="Enter your business email" required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label cart-item__label" for="merchant-login-password">Password</label>
                                <input class="form-control form-control-lg rounded-0" id="merchant-login-password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
                            </div>
                            <button class="button product-card__button w-100" type="submit">Sign In</button>
                            <p class="auth-card__registration mt-4 mb-0 text-center">Don't have an account? <a class="text-link" asp-area="" asp-controller="Home" asp-action="MerchantRegister">Register</a></p>
                            <p class="auth-status mt-4" data-auth-status aria-live="polite" hidden></p>
                        </form>
                    </div>
                </div>
                <a class="text-link text-link--light mt-4" asp-area="" asp-controller="Home" asp-action="Portal"><span aria-hidden="true">←</span> Back to portal</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/portal-auth.js" asp-append-version="true"></script>
}
