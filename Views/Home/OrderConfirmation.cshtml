@model CampusCoffeeSystem.Models.CustomerOrder?
@{
    ViewData["Title"] = "Order Confirmation";
}

<section class="our-story-hero portal-surface" aria-labelledby="order-confirmation-title">
    <div class="site-shell reveal">
        <p class="eyebrow eyebrow--light">Order received</p>
        <h1 id="order-confirmation-title">Thank you.</h1>
        <p class="our-story-hero__subtitle">Your order is now stored and ready for the Campus Coffee team.</p>
    </div>
</section>

<section class="menu-catalog portal-surface">
    <div class="site-shell">
        @if (Model is null)
        {
            <div class="menu-empty">
                <p class="eyebrow">Order not found</p>
                <h2>We could not find that order.</h2>
                <a class="button product-card__button mt-4" asp-controller="Home" asp-action="Menu">Return to menu</a>
            </div>
        }
        else
        {
            <div class="row g-5">
                <div class="col-lg-7">
                    <article class="product-card reveal">
                        <div class="product-card__body">
                            <div class="product-card__heading"><h2>Order @Model.OrderNumber</h2><span class="administrator-badge administrator-badge--pending">@Model.Status</span></div>
                            <div class="menu-note mt-4"><span>Name</span><strong>@Model.CustomerName</strong></div>
                            <div class="menu-note mt-0"><span>Email</span><strong>@Model.Email</strong></div>
                            <div class="menu-note mt-0"><span>Phone</span><strong>@Model.Phone</strong></div>
                            <div class="menu-note mt-0"><span>Method</span><strong>@Model.OrderMethod</strong></div>
                            @if (string.Equals(Model.OrderMethod, "Delivery", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="menu-note mt-0">
                                    <span>Delivery address</span>
                                    <strong>
                                        @Model.DeliveryAddressLine1<br />
                                        @if (!string.IsNullOrWhiteSpace(Model.DeliveryAddressLine2))
                                        {
                                            @Model.DeliveryAddressLine2<br />
                                        }
                                        @Model.DeliveryCity @Model.DeliveryPostcode
                                    </strong>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.SpecialNotes))
                            {
                                <div class="menu-note mt-0"><span>Notes</span><strong style="white-space:pre-wrap">@Model.SpecialNotes</strong></div>
                            }
                        </div>
                    </article>
                </div>
                <div class="col-lg-5">
                    <aside class="product-card reveal">
                        <div class="product-card__body">
                            <div class="product-card__heading"><h2>Order summary</h2></div>
                            @foreach (var item in Model.Items)
                            {
                                <div class="menu-note mt-0">
                                    <span><strong class="d-block">@item.ProductName</strong>@item.Quantity × @CurrencyFormatter.NzDollars(item.UnitPrice)</span>
                                    <strong>@CurrencyFormatter.NzDollars(item.Quantity * item.UnitPrice)</strong>
                                </div>
                            }
                            <div class="menu-note mt-4"><span>Subtotal</span><strong>@CurrencyFormatter.NzDollars(Model.Subtotal)</strong></div>
                            <div class="menu-note mt-0"><span>Delivery</span><strong>@CurrencyFormatter.NzDollars(Model.DeliveryFee)</strong></div>
                            <div class="menu-note mt-0"><strong>Total</strong><span class="product-card__price">@CurrencyFormatter.NzDollars(Model.Total)</span></div>
                            <a class="button product-card__button w-100 mt-4" asp-controller="Home" asp-action="Menu">Continue shopping</a>
                        </div>
                    </aside>
                </div>
            </div>
        }
    </div>
</section>
