@model CampusCoffeeSystem.Models.AdministratorDashboardViewModel
@using CampusCoffeeSystem.Models
@{
    ViewData["Title"] = "Administrator Dashboard";
    Layout = "_AdministratorDashboardLayout";

    var pendingApplications = Model.MerchantApplications.Count(item => item.Status == MerchantApplicationStatuses.Pending);
    var approvedMerchants = Model.MerchantApplications.Count(item => item.Status == MerchantApplicationStatuses.Approved);
    var activeProducts = Model.Products.Count(item => item.IsActive);
    var todayOrders = Model.Orders.Count(item => item.PlacedAtUtc.ToLocalTime().Date == DateTime.Now.Date);
    var unarchivedCompletedOrders = Model.Orders.Count(item => item.Status == OrderStatuses.Completed && !item.IsArchived);
    var attentionTotal = pendingApplications + unarchivedCompletedOrders;
    var loadedOrderValue = Model.Orders.Sum(item => item.Total);
    var completedOrders = Model.Orders.Count(item => item.Status == OrderStatuses.Completed);
    var completionRate = Model.Orders.Count == 0 ? 0 : Math.Round(completedOrders * 100m / Model.Orders.Count, 1);
    var topProducts = Model.Orders
        .SelectMany(order => order.Items)
        .GroupBy(item => item.ProductName)
        .Select(group => new { Name = group.Key, Quantity = group.Sum(item => item.Quantity) })
        .OrderByDescending(item => item.Quantity)
        .ThenBy(item => item.Name)
        .Take(4)
        .ToList();
    var topProductQuantity = Math.Max(1, topProducts.Select(item => item.Quantity).DefaultIfEmpty(0).Max());
    var orderStatusCounts = new[]
    {
        new { Label = "Pending", Count = Model.Orders.Count(item => item.Status == OrderStatuses.Pending) },
        new { Label = "Preparing", Count = Model.Orders.Count(item => item.Status == OrderStatuses.Preparing) },
        new { Label = "Ready", Count = Model.Orders.Count(item => item.Status == OrderStatuses.Ready) },
        new { Label = "Completed", Count = completedOrders },
        new { Label = "Cancelled", Count = Model.Orders.Count(item => item.Status == OrderStatuses.Cancelled) }
    };
    var largestStatusCount = Math.Max(1, orderStatusCounts.Max(item => item.Count));
    var activityItems = Model.Orders
        .Select(order => new
        {
            At = order.PlacedAtUtc,
            Title = $"Order {order.OrderNumber} · {order.Status}",
            Detail = $"{order.CustomerName} · {order.Total:C}",
            Kind = "order"
        })
        .Concat(Model.MerchantApplications.Select(application => new
        {
            At = application.SubmittedAtUtc,
            Title = $"{application.BusinessName} · {application.Status}",
            Detail = $"Merchant application from {application.ContactName}",
            Kind = "merchant"
        }))
        .OrderByDescending(item => item.At)
        .Take(5)
        .ToList();

    string GetInitials(string value)
    {
        var initials = string.Concat(value
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
        return string.IsNullOrWhiteSpace(initials) ? "A" : initials;
    }

    string GetOrderBadge(CustomerOrder order)
    {
        if (order.IsArchived || order.Status == OrderStatuses.Cancelled) return "inactive";
        return order.Status switch
        {
            OrderStatuses.Completed => "active",
            OrderStatuses.Ready => "ready",
            OrderStatuses.Preparing => "preparing",
            _ => "pending"
        };
    }
}

<div class="administrator-dashboard" data-administrator-dashboard>
    <form class="visually-hidden" data-administrator-token>@Html.AntiForgeryToken()</form>

    <aside class="administrator-sidebar" aria-label="Administrator portal navigation">
        <a class="brand administrator-sidebar__brand" asp-area="" asp-controller="Home" asp-action="Portal" aria-label="Campus Coffee Access Portal">
            <span class="brand__mark" aria-hidden="true"><svg viewBox="0 0 44 44"><path d="M11 16h19v9a9 9 0 0 1-9 9h-1a9 9 0 0 1-9-9v-9Z"/><path d="M30 19h2a5 5 0 0 1 0 10h-3M16 11c0-2 2-2 2-4M23 11c0-2 2-2 2-4"/></svg></span>
            <span class="brand__text"><strong>CAMPUS</strong><small>ADMINISTRATION</small></span>
        </a>

        <p class="administrator-sidebar__label">Platform control</p>
        <nav class="administrator-sidebar__nav">
            <button class="is-active" type="button" data-admin-nav="dashboard" aria-current="page"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z"/></svg></span><span>Dashboard</span></button>
            <button type="button" data-admin-nav="users"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-1a3 3 0 1 0 0-6m0 11a4 4 0 0 1 4 4v2"/></svg></span><span>Users</span><span class="administrator-nav-count">@Model.Users.Count</span></button>
            <button type="button" data-admin-nav="merchants"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M4 10h16v10H4V10Zm2-6h12l2 6H4l2-6Zm3 16v-6h6v6"/></svg></span><span>Merchants</span><span class="administrator-nav-count">@pendingApplications</span></button>
            <button type="button" data-admin-nav="products"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10"/></svg></span><span>Products</span><span class="administrator-nav-count">@Model.Products.Count</span></button>
            <button type="button" data-admin-nav="orders"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M5 4h14v17l-3-2-4 2-4-2-3 2V4Zm4 5h6m-6 4h6"/></svg></span><span>Orders</span><span class="administrator-nav-count">@Model.Orders.Count</span></button>
            <button type="button" data-admin-nav="feedback"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M4 5h16v12H8l-4 4V5Zm4 5h8m-8 3h5"/></svg></span><span>Feedback</span></button>
            <button type="button" data-admin-nav="reports"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M5 20V10m5 10V4m5 16v-7m5 7H2"/></svg></span><span>Reports</span></button>
            <button type="button" data-admin-nav="permissions"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 5 3 8 8 10 5-2 8-5 8-10V6l-8-3Zm-3 9 2 2 4-5"/></svg></span><span>Permissions</span></button>
            <button type="button" data-admin-nav="settings"><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM19 12l2-1-2-4-2 .5L15 5l-.5-2h-5L9 5 7 7.5 5 7l-2 4 2 1-2 1 2 4 2-.5L9 19l.5 2h5l.5-2 2-2.5 2 .5 2-4-2-1Z"/></svg></span><span>System Settings</span></button>
            <a asp-area="" asp-controller="Home" asp-action="Portal" data-administrator-logout><span class="administrator-nav-icon"><svg viewBox="0 0 24 24"><path d="M10 5H4v14h6M14 8l4 4-4 4M8 12h10"/></svg></span><span>Logout</span></a>
        </nav>

        <div class="administrator-sidebar__profile">
            <span class="administrator-avatar administrator-avatar--small">@GetInitials(Model.DisplayName)</span>
            <div><strong>@Model.DisplayName</strong><small>@Model.Email</small></div>
        </div>
    </aside>

    <main class="administrator-main" id="administrator-main">
        <header class="administrator-header">
            <div>
                <p class="administrator-kicker">Administrator portal</p>
                <h1>Welcome back, @Model.DisplayName</h1>
                <time data-administrator-date></time>
            </div>
            <div class="administrator-header__tools">
                <label class="administrator-search">
                    <span class="visually-hidden">Search administrator portal</span>
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
                    <input type="search" placeholder="Search the platform" data-administrator-search />
                    <kbd>Ctrl K</kbd>
                </label>
                <button class="administrator-icon-button" type="button" aria-label="View recent database activity" data-activity-button><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></svg>@if (activityItems.Count > 0) { <span></span> }</button>
                <button class="administrator-profile" type="button" data-admin-nav="settings" aria-label="Open administrator settings"><span class="administrator-avatar">@GetInitials(Model.DisplayName)</span><span><strong>@Model.DisplayName</strong><small>Administrator access</small></span><svg viewBox="0 0 24 24"><path d="m8 10 4 4 4-4"/></svg></button>
            </div>
        </header>

        <p class="administrator-notice" data-administrator-status aria-live="polite" hidden></p>

        <section class="administrator-section administrator-section--first" id="admin-dashboard" data-admin-section="dashboard" aria-labelledby="system-overview-title">
            <div class="administrator-section-heading administrator-reveal"><div><p class="administrator-kicker">Platform overview</p><h2 id="system-overview-title">One platform.<br />Real database records.</h2></div><p>These totals are loaded from SQL Server through the administrator dashboard model.</p></div>
            <div class="administrator-stat-grid">
                <article class="administrator-stat-card administrator-reveal"><div><span>Registered Users</span><span class="administrator-trend">Identity</span></div><strong data-admin-count="@Model.Users.Count">0</strong><small>Customer, merchant and administrator accounts</small><i>01</i></article>
                <article class="administrator-stat-card administrator-reveal"><div><span>Approved Merchants</span><span class="administrator-trend">@pendingApplications pending</span></div><strong data-admin-count="@approvedMerchants">0</strong><small>Approved merchant applications</small><i>02</i></article>
                <article class="administrator-stat-card administrator-reveal"><div><span>Today’s Orders</span><span class="administrator-trend">@Model.Orders.Count stored</span></div><strong data-admin-count="@todayOrders">0</strong><small>Orders placed today in local time</small><i>03</i></article>
                <article class="administrator-stat-card administrator-stat-card--espresso administrator-reveal"><div><span>Active Products</span><span class="administrator-trend administrator-trend--light">@Model.Products.Count total</span></div><strong data-admin-count="@activeProducts">0</strong><small>Products currently visible on the menu</small><i>04</i></article>
            </div>
        </section>

        <section class="administrator-section administrator-platform-grid" aria-label="Administrator work queue">
            <div class="administrator-content-card administrator-reveal" id="admin-activity">
                <div class="administrator-card-title"><div><p class="administrator-kicker">Recent activities</p><h2 id="activity-title">Database movements.</h2></div><span class="administrator-live-pill"><i></i> Stored records</span></div>
                <div class="administrator-activity-list">
                    @if (activityItems.Count == 0)
                    {
                        <p>No order or merchant application activity is stored yet.</p>
                    }
                    @foreach (var activity in activityItems)
                    {
                        <article data-admin-search-item>
                            <span class="administrator-activity-icon @(activity.Kind == "order" ? "administrator-activity-icon--order" : "administrator-activity-icon--success")">
                                @if (activity.Kind == "order")
                                {
                                    <svg viewBox="0 0 24 24"><path d="M5 4h14v17l-3-2-4 2-4-2-3 2V4Zm4 6h6"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24"><path d="M4 10h16v10H4V10Zm2-6h12l2 6H4l2-6"/></svg>
                                }
                            </span>
                            <div><strong>@activity.Title</strong><p>@activity.Detail</p></div>
                            <time datetime="@activity.At.ToString("O")">@activity.At.ToLocalTime().ToString("dd MMM, HH:mm")</time>
                        </article>
                    }
                </div>
            </div>

            <div class="administrator-content-card administrator-reveal" id="admin-tasks">
                <div class="administrator-card-title"><div><p class="administrator-kicker">Administrative tasks</p><h2>Needs attention.</h2></div><span class="administrator-task-total">@attentionTotal pending</span></div>
                <div class="administrator-task-list">
                    <button type="button" data-admin-nav="merchants"><span class="administrator-task-icon">MA</span><span><strong>Merchant Applications</strong><small>Review account requests</small></span><span class="administrator-badge @(pendingApplications > 0 ? "administrator-badge--pending" : "administrator-badge--active")">@pendingApplications Pending</span></button>
                    <button type="button" data-admin-nav="products"><span class="administrator-task-icon">MP</span><span><strong>Menu Products</strong><small>Review product availability</small></span><span class="administrator-badge administrator-badge--active">@activeProducts Active</span></button>
                    <button type="button" data-admin-nav="orders"><span class="administrator-task-icon">OA</span><span><strong>Order Archive</strong><small>Archive completed records</small></span><span class="administrator-badge @(unarchivedCompletedOrders > 0 ? "administrator-badge--ready" : "administrator-badge--active")">@unarchivedCompletedOrders Ready</span></button>
                </div>
            </div>
        </section>

        <section class="administrator-quick-actions administrator-reveal" aria-labelledby="quick-actions-title">
            <div><p class="administrator-kicker">Quick actions</p><h2 id="quick-actions-title">Platform controls, close at hand.</h2></div>
            <div>
                <button type="button" data-admin-nav="merchants">Review merchants</button>
                <button type="button" data-admin-nav="products">Manage products</button>
                <button type="button" data-admin-nav="orders">Review orders</button>
                <button type="button" data-admin-nav="reports">View live report</button>
                <button type="button" data-admin-nav="users">View users</button>
                <button type="button" disabled title="No database backup service is connected">Backup not configured</button>
            </div>
        </section>

        <section class="administrator-section" id="admin-users" data-admin-section="users" aria-labelledby="users-title">
            <div class="administrator-section-heading administrator-reveal"><div><p class="administrator-kicker">Users management</p><h2 id="users-title">People and access.</h2></div><p>Search and filter the accounts and assigned roles currently stored by ASP.NET Identity.</p></div>
            <div class="administrator-content-card administrator-reveal">
                <div class="administrator-user-tools"><label><span class="visually-hidden">Search users</span><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><input type="search" placeholder="Search users" data-user-search /></label><label><span class="visually-hidden">Filter users by role</span><select data-user-role-filter><option value="all">All roles</option><option value="customer">Customer</option><option value="merchant">Merchant</option><option value="administrator">Administrator</option><option value="pending">Pending</option></select></label></div>
                <div class="table-responsive"><table class="administrator-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Access state</th></tr></thead><tbody>
                    @if (Model.Users.Count == 0)
                    {
                        <tr><td colspan="4">No Identity users are stored.</td></tr>
                    }
                    @foreach (var user in Model.Users)
                    {
                        var roleKey = user.Role.ToLowerInvariant();
                        var hasAssignedRole = !string.Equals(user.Role, "Pending", StringComparison.OrdinalIgnoreCase);
                        <tr data-admin-search-item data-user-row data-user-role="@roleKey"><td><span class="administrator-person"><span>@GetInitials(user.DisplayName)</span><strong>@user.DisplayName</strong></span></td><td>@user.Email</td><td>@user.Role</td><td><span class="administrator-badge administrator-badge--@(hasAssignedRole ? "active" : "pending")">@(hasAssignedRole ? "Role assigned" : "Awaiting role")</span></td></tr>
                    }
                </tbody></table></div>
            </div>
        </section>

        <section class="administrator-section" id="admin-merchants" data-admin-section="merchants" aria-labelledby="merchants-title">
            <div class="administrator-section-heading administrator-reveal"><div><p class="administrator-kicker">Merchant management</p><h2 id="merchants-title">Businesses on the platform.</h2></div><p>Applications, review status and contact information come directly from the merchant application table.</p></div>
            @if (Model.MerchantApplications.Count == 0)
            {
                <div class="administrator-content-card administrator-reveal"><p>No merchant applications have been submitted.</p></div>
            }
            else
            {
                <div class="administrator-merchant-grid">
                    @foreach (var application in Model.MerchantApplications)
                    {
                        var statusClass = application.Status == MerchantApplicationStatuses.Approved
                            ? "active"
                            : application.Status == MerchantApplicationStatuses.Pending ? "pending" : "inactive";
                        <article class="administrator-merchant-card administrator-reveal" data-admin-search-item data-merchant-application data-application-id="@application.Id" data-merchant-name="@application.BusinessName">
                            <div class="administrator-merchant-card__top"><span class="administrator-store-mark">@GetInitials(application.BusinessName)</span><span class="administrator-badge administrator-badge--@statusClass" data-merchant-status>@application.Status</span></div>
                            <h3>@application.BusinessName</h3><p>@(string.IsNullOrWhiteSpace(application.Address) ? "No address supplied" : application.Address)</p>
                            <dl><div><dt>Contact</dt><dd>@application.ContactName</dd></div><div><dt>Email</dt><dd>@application.Email</dd></div><div><dt>Submitted</dt><dd>@application.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd></div></dl>
                            @if (application.Status == MerchantApplicationStatuses.Pending)
                            {
                                <div><button type="button" data-merchant-action="Approved">Approve</button><button type="button" data-merchant-action="Rejected">Reject</button></div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="administrator-section" id="admin-products" data-admin-section="products" aria-labelledby="products-title">
            <div class="administrator-section-heading administrator-reveal"><div><p class="administrator-kicker">Product moderation</p><h2 id="products-title">The live platform menu.</h2></div><p>Every product card reflects the stored price, stock and menu availability.</p></div>
            @if (Model.Products.Count == 0)
            {
                <div class="administrator-content-card administrator-reveal"><p>No products are stored.</p></div>
            }
            else
            {
                <div class="administrator-product-grid">
                    @foreach (var product in Model.Products)
                    {
                        var imagePath = string.IsNullOrWhiteSpace(product.ImagePath) ? "~/images/home/coffee-hero-top-view.jpg" : product.ImagePath;
                        <article class="administrator-product-card administrator-reveal" data-admin-search-item data-product-row data-product-id="@product.Id" data-product-name="@product.Name">
                            <img src="@Url.Content(imagePath)" alt="@product.Name" />
                            <div><span class="administrator-badge administrator-badge--@(product.IsActive ? "active" : "inactive")" data-product-status>@(product.IsActive ? "Active" : "Disabled")</span><h3>@product.Name</h3><p>@product.DisplayCategory · @product.Price.ToString("C") · @product.StockQuantity in stock</p><div class="administrator-product-actions"><button type="button" data-product-toggle>@(product.IsActive ? "Disable" : "Enable")</button></div></div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="administrator-section" id="admin-orders" data-admin-section="orders" aria-labelledby="orders-title">
            <div class="administrator-section-heading administrator-reveal"><div><p class="administrator-kicker">Platform orders</p><h2 id="orders-title">Every stored order.</h2></div><p>The latest order records, customer details, fulfilment state and totals from SQL Server.</p></div>
            <div class="administrator-content-card administrator-reveal"><div class="table-responsive"><table class="administrator-table"><thead><tr><th>Order ID</th><th>Customer</th><th>Method</th><th>Status</th><th>Amount</th><th>Placed</th><th>Action</th></tr></thead><tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr><td colspan="7">No customer orders are stored.</td></tr>
                }
                @foreach (var order in Model.Orders)
                {
                    <tr data-admin-search-item data-order-row data-order-id="@order.Id" class="@(order.IsArchived ? "is-archived" : string.Empty)"><td><strong>@order.OrderNumber</strong></td><td>@order.CustomerName<br /><small>@order.Email</small></td><td>@order.OrderMethod</td><td><span class="administrator-badge administrator-badge--@GetOrderBadge(order)" data-order-status>@(order.IsArchived ? "Archived" : order.Status)</span></td><td>@order.Total.ToString("C")</td><td>@order.PlacedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</td><td>@if (!order.IsArchived) { <button type="button" data-order-archive>Archive</button> }</td></tr>
                }
            </tbody></table></div></div>
        </section>

        <section class="administrator-section" id="admin-feedback" data-admin-section="feedback" aria-labelledby="feedback-title">
            <div class="administrator-section-heading administrator-reveal"><div><p class="administrator-kicker">Feedback moderation</p><h2 id="feedback-title">Ready for a future data source.</h2></div><p>The frontend section is retained, but this version has no feedback entity or feedback table.</p></div>
            <div class="administrator-content-card administrator-reveal"><div class="administrator-card-title"><div><p class="administrator-kicker">Database status</p><h2>No feedback records available.</h2></div><span class="administrator-badge administrator-badge--pending">Not connected</span></div><p>No sample reviews or moderation actions are shown because the database cannot currently provide them.</p></div>
        </section>

        <section class="administrator-section" id="admin-reports" data-admin-section="reports" aria-labelledby="reports-title">
            <div class="administrator-section-heading administrator-reveal"><div><p class="administrator-kicker">Reports &amp; analytics</p><h2 id="reports-title">The stored data,<br />measured clearly.</h2></div><button class="administrator-primary-button" type="button" disabled title="No report export endpoint is connected">Export unavailable</button></div>
            <div class="administrator-analytics-grid">
                <article class="administrator-chart-card administrator-chart-card--wide administrator-reveal"><div class="administrator-card-heading"><div><span>Loaded Order Value</span><strong>@loadedOrderValue.ToString("C")</strong><small>Sum of the @Model.Orders.Count latest order records loaded on this page</small></div><span class="administrator-badge administrator-badge--active">Database total</span></div><div class="administrator-report-grid"><div class="administrator-report-card"><span>01</span><p>Users</p><strong>@Model.Users.Count</strong><small>Identity accounts</small></div><div class="administrator-report-card"><span>02</span><p>Merchants</p><strong>@approvedMerchants</strong><small>Approved</small></div><div class="administrator-report-card"><span>03</span><p>Products</p><strong>@activeProducts</strong><small>Active</small></div><div class="administrator-report-card"><span>04</span><p>Orders</p><strong>@Model.Orders.Count</strong><small>Loaded records</small></div><div class="administrator-report-card"><span>05</span><p>Completed</p><strong>@completionRate%</strong><small>Loaded orders</small></div></div></article>
                <article class="administrator-chart-card administrator-reveal"><div class="administrator-card-heading"><div><span>Orders by Status</span><strong>@Model.Orders.Count loaded</strong><small>Current database distribution</small></div></div><div class="administrator-bar-chart" aria-label="Order count by status">@foreach (var status in orderStatusCounts) { var height = (int)Math.Round(status.Count * 100d / largestStatusCount); <span style="height:@height%" title="@status.Label: @status.Count"><i>@status.Label</i></span> }</div></article>
                <article class="administrator-chart-card administrator-reveal"><div class="administrator-card-heading"><div><span>Merchant Applications</span><strong>@approvedMerchants approved</strong><small>@pendingApplications awaiting review · @Model.MerchantApplications.Count total</small></div></div><div class="administrator-mini-trend"><div><span>Pending applications</span><strong>@pendingApplications</strong></div><div><span>All applications</span><strong>@Model.MerchantApplications.Count</strong></div></div></article>
                <article class="administrator-chart-card administrator-reveal"><div class="administrator-card-heading"><div><span>Best Selling Menu Items</span><strong>Stored order items</strong><small>Ranked by quantity in loaded orders</small></div></div>@if (topProducts.Count == 0) { <p>No order items are available for ranking.</p> } else { <ol class="administrator-sales-ranking">@for (var index = 0; index < topProducts.Count; index++) { var product = topProducts[index]; var width = (int)Math.Round(product.Quantity * 100d / topProductQuantity); <li><b>@((index + 1).ToString("00"))</b><span>@product.Name</span><i style="--value:@width%"></i><strong>@product.Quantity</strong></li> }</ol> }</article>
                <article class="administrator-chart-card administrator-reveal"><div class="administrator-card-heading"><div><span>Catering Requests</span><strong>Unavailable</strong><small>No catering request table is implemented</small></div></div><div class="administrator-mini-trend"><div><span>Database records</span><strong>—</strong></div></div><p>This card intentionally contains no sample figures.</p></article>
            </div>
        </section>

