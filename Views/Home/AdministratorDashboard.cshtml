@{
    ViewData["Title"] = "Administrator Dashboard";
}

<section class="our-story-hero portal-surface" aria-labelledby="administrator-dashboard-title">
    <div class="site-shell reveal">
        <p class="eyebrow eyebrow--light">Administrator Dashboard</p>
        <h1 id="administrator-dashboard-title">Welcome Administrator</h1>
        <p class="our-story-hero__subtitle">Campus Coffee oversight and reporting.</p>
    </div>
</section>

<section class="section section--paper portal-surface">
    <div class="site-shell">
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col"><article class="product-card portal-card h-100 reveal"><div class="product-card__body"><span class="value-card__number">01</span><div class="product-card__heading mt-5"><h3>User Management</h3></div><p class="product-card__description">A placeholder for customer, merchant and administrator accounts.</p><a class="button product-card__button mt-auto" href="#">User Management</a></div></article></div>
            <div class="col"><article class="product-card portal-card h-100 reveal"><div class="product-card__body"><span class="value-card__number">02</span><div class="product-card__heading mt-5"><h3>Merchant Applications</h3></div><p class="product-card__description">A placeholder for reviewing and approving merchant requests.</p><a class="button product-card__button mt-auto" href="#">Merchant Applications</a></div></article></div>
            <div class="col"><article class="product-card portal-card h-100 reveal"><div class="product-card__body"><span class="value-card__number">03</span><div class="product-card__heading mt-5"><h3>Reports</h3></div><p class="product-card__description">A placeholder for operational summaries and platform reports.</p><a class="button product-card__button mt-auto" href="#">Reports</a></div></article></div>
        </div>
    </div>
</section>
