@{
    ViewData["Title"] = "Welcome to Campus Coffee";
    var email = ViewData["Email"] as string;
}

<section class="our-story-hero portal-surface" aria-labelledby="registration-confirmation-title">
    <div class="site-shell reveal">
        <p class="eyebrow eyebrow--light">Welcome to Campus Coffee</p>
        <h1 id="registration-confirmation-title">Thank you for joining us</h1>
        <p class="our-story-hero__subtitle">Your account is almost ready.</p>
    </div>
</section>

<section class="menu-catalog portal-surface">
    <div class="site-shell">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-7">
                <div class="product-card auth-card reveal">
                    <div class="product-card__body auth-message">
                        <p class="auth-status">We have sent a confirmation link to <strong>@email</strong>. Please check your inbox, confirm your email address, and then return to sign in.</p>
                        <p>We are delighted to welcome you to the Campus Coffee &amp; Catering community. We look forward to serving you.</p>
                        <a class="button product-card__button" asp-controller="Home" asp-action="CustomerLogin">Continue to sign in</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
