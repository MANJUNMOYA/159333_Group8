@{
    ViewData["Title"] = "Shopping Cart";
}

<section class="menu-hero" aria-labelledby="cart-title">
    <div class="menu-hero__shade"></div>
    <div class="site-shell menu-hero__content">
        <p class="eyebrow eyebrow--light">Ready when you are</p>
        <h1 id="cart-title">Your<br />order.</h1>
        <p>Review your campus favourites before heading to checkout.</p>
    </div>
</section>

<div class="promise-strip" aria-label="Order highlights">
    <div class="promise-strip__track">
        <span>Freshly made</span><i></i><span>Campus pickup</span><i></i><span>Simple ordering</span><i></i><span>Good food, no fuss</span><i></i>
    </div>
</div>

<section class="menu-catalog" data-shopping-cart>
    <div class="site-shell">
        <div class="row g-4 g-xl-5 align-items-start">
            <div class="col-xl-8">
                <div class="menu-group__heading d-block reveal">
                    <p class="eyebrow">In your cart</p>
                    <h2 data-cart-heading>Three campus favourites.</h2>
                </div>

                <div class="cart-items" data-cart-items hidden>
                    <article class="product-card cart-item reveal">
                        <div class="row g-0 align-items-stretch">
                            <div class="cart-item__media">
                                <div class="product-card__image h-100">
                                    <img src="~/images/menu/Campus Flat White.jpg" alt="Campus Flat White with leaf art" />
                                    <span class="product-card__category">Coffee</span>
                                </div>
                            </div>
                            <div class="cart-item__content">
                                <div class="product-card__body h-100">
                                    <div class="product-card__heading">
                                        <h3>Campus Flat White</h3>
                                    </div>
                                    <p class="product-card__description">Double espresso with smooth steamed milk.</p>
                                    <div class="product-card__footer cart-item__footer">
                                        <div class="cart-item__quantity">
                                            <span class="cart-item__label">Quantity</span>
                                            <div class="d-flex align-items-stretch" aria-label="Quantity 2">
                                                <button class="button product-card__button px-3" type="button" aria-label="Decrease Campus Flat White quantity">−</button>
                                                <span class="cart-item__quantity-value d-inline-flex align-items-center justify-content-center border-top border-bottom px-3 fw-bold">2</span>
                                                <button class="button product-card__button px-3" type="button" aria-label="Increase Campus Flat White quantity">+</button>
                                            </div>
                                        </div>
                                        <div class="cart-item__unit-price">
                                            <span class="cart-item__label">Unit price</span>
                                            <span class="product-card__price">$4.80</span>
                                        </div>
                                        <button class="cart-item__remove text-link bg-transparent border-top-0 border-start-0 border-end-0 p-0" type="button">Remove</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>

                    <article class="product-card cart-item reveal">
                        <div class="row g-0 align-items-stretch">
                            <div class="cart-item__media">
                                <div class="product-card__image h-100">
                                    <img src="~/images/menu/Butter Croissant.jpg" alt="Freshly baked butter croissant" />
                                    <span class="product-card__category">Bakery</span>
                                </div>
                            </div>
                            <div class="cart-item__content">
                                <div class="product-card__body h-100">
                                    <div class="product-card__heading">
                                        <h3>Butter Croissant</h3>
                                    </div>
                                    <p class="product-card__description">Flaky, golden and baked fresh each morning.</p>
                                    <div class="product-card__footer cart-item__footer">
                                        <div class="cart-item__quantity">
                                            <span class="cart-item__label">Quantity</span>
                                            <div class="d-flex align-items-stretch" aria-label="Quantity 1">
                                                <button class="button product-card__button px-3" type="button" aria-label="Decrease Butter Croissant quantity">−</button>
                                                <span class="cart-item__quantity-value d-inline-flex align-items-center justify-content-center border-top border-bottom px-3 fw-bold">1</span>
                                                <button class="button product-card__button px-3" type="button" aria-label="Increase Butter Croissant quantity">+</button>
                                            </div>
                                        </div>
                                        <div class="cart-item__unit-price">
                                            <span class="cart-item__label">Unit price</span>
                                            <span class="product-card__price">$4.90</span>
                                        </div>
                                        <button class="cart-item__remove text-link bg-transparent border-top-0 border-start-0 border-end-0 p-0" type="button">Remove</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>

                    <article class="product-card cart-item reveal">
                        <div class="row g-0 align-items-stretch">
                            <div class="cart-item__media">
                                <div class="product-card__image h-100">
                                    <img src="~/images/menu/Garden Salad Bowl.jpg" alt="Fresh Garden Salad Bowl" />
                                    <span class="product-card__category">Lunch</span>
                                </div>
                            </div>
                            <div class="cart-item__content">
                                <div class="product-card__body h-100">
                                    <div class="product-card__heading">
                                        <h3>Garden Salad Bowl</h3>
                                    </div>
                                    <p class="product-card__description">Seasonal greens, roast vegetables and herb dressing.</p>
                                    <div class="product-card__footer cart-item__footer">
                                        <div class="cart-item__quantity">
                                            <span class="cart-item__label">Quantity</span>
                                            <div class="d-flex align-items-stretch" aria-label="Quantity 1">
                                                <button class="button product-card__button px-3" type="button" aria-label="Decrease Garden Salad Bowl quantity">−</button>
                                                <span class="cart-item__quantity-value d-inline-flex align-items-center justify-content-center border-top border-bottom px-3 fw-bold">1</span>
                                                <button class="button product-card__button px-3" type="button" aria-label="Increase Garden Salad Bowl quantity">+</button>
                                            </div>
                                        </div>
                                        <div class="cart-item__unit-price">
                                            <span class="cart-item__label">Unit price</span>
                                            <span class="product-card__price">$11.20</span>
                                        </div>
                                        <button class="cart-item__remove text-link bg-transparent border-top-0 border-start-0 border-end-0 p-0" type="button">Remove</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>

                <div class="product-card" data-cart-empty hidden>
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3>Your cart is empty</h3>
                        </div>
                        <p class="product-card__description">Add a coffee or something fresh from the menu to get started.</p>
                        <a class="button product-card__button align-self-start" asp-area="" asp-controller="Home" asp-action="Menu">Browse the menu</a>
                    </div>
                </div>

                <template data-cart-item-template>
                    <article class="product-card cart-item reveal is-visible" data-cart-item>
                        <div class="row g-0 align-items-stretch">
                            <div class="cart-item__media">
                                <div class="product-card__image h-100">
                                    <img data-cart-image src="" alt="" />
                                    <span class="product-card__category" data-cart-category></span>
                                </div>
                            </div>
                            <div class="cart-item__content">
                                <div class="product-card__body h-100">
                                    <div class="product-card__heading">
                                        <h3 data-cart-name></h3>
                                    </div>
                                    <p class="product-card__description" data-cart-description></p>
                                    <div class="product-card__footer cart-item__footer">
                                        <div class="cart-item__quantity">
                                            <span class="cart-item__label">Quantity</span>
                                            <div class="d-flex align-items-stretch" data-cart-quantity-controls>
                                                <button class="button product-card__button px-3" type="button" data-cart-decrease>&minus;</button>
                                                <span class="cart-item__quantity-value d-inline-flex align-items-center justify-content-center border-top border-bottom px-3 fw-bold" data-cart-quantity></span>
                                                <button class="button product-card__button px-3" type="button" data-cart-increase>+</button>
                                            </div>
                                        </div>
                                        <div class="cart-item__unit-price">
                                            <span class="cart-item__label">Unit price</span>
                                            <span class="product-card__price" data-cart-price></span>
                                        </div>
                                        <button class="cart-item__remove text-link bg-transparent border-top-0 border-start-0 border-end-0 p-0" type="button" data-cart-remove>Remove</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                </template>
            </div>

            <div class="col-xl-4">
                <aside class="product-card reveal" aria-labelledby="order-summary-title">
                    <div class="product-card__body">
                        <div class="product-card__heading">
                            <h3 id="order-summary-title">Order Summary</h3>
                        </div>

                        <div class="menu-note mt-4">
                            <span>Subtotal</span>
                            <strong data-cart-subtotal>$25.70</strong>
                        </div>
                        <div class="menu-note mt-0">
                            <span>Delivery fee</span>
                            <strong data-cart-delivery>$3.50</strong>
                        </div>
                        <div class="menu-note mt-0 align-items-center">
                            <strong>Total</strong>
                            <span class="product-card__price" data-cart-total>$29.20</span>
                        </div>

                        <a class="button product-card__button w-100 mt-4" asp-area="" asp-controller="Home" asp-action="Checkout">Checkout</a>
                        <a class="text-link justify-content-center mt-4" asp-area="" asp-controller="Home" asp-action="Menu">Continue shopping <span aria-hidden="true">→</span></a>
                    </div>
                </aside>
            </div>
        </div>

        <p class="visually-hidden" data-cart-status aria-live="polite"></p>
    </div>
</section>
