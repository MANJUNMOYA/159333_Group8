@model CampusCoffeeSystem.Models.ProductDetailsViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    var stockLabel = product.StockQuantity == 0 ? "Sold out" : product.StockQuantity <= 8 ? $"Low stock ({product.StockQuantity} left)" : "In stock";
}

<section class="catering" aria-labelledby="product-title" data-product-details
         data-product-id="@product.Id"
         data-product-name="@product.Name"
         data-product-price="@product.Price"
         data-product-image="@product.ImagePath"
         data-product-category="@product.DisplayCategory">
    <div class="catering__image" style="background-image: url('@product.ImagePath');" role="img" aria-label="@product.Name"></div>
    <div class="catering__panel reveal">
        <a class="text-link text-link--light mb-5" asp-controller="Home" asp-action="Menu"><span aria-hidden="true">←</span> Back to menu</a>
        <p class="eyebrow eyebrow--light">@product.DisplayCategory</p>
        <h2 id="product-title">@product.Name</h2>
        <p>@product.Description</p>
        <ul class="catering__features">
            <li><span>Price</span><strong>@CurrencyFormatter.NzDollars(product.Price)</strong></li>
            <li class="flex-wrap">
                <span>Dietary</span>
                @if (!string.IsNullOrWhiteSpace(product.DietaryLabel)) { <span class="border border-light px-2 py-1">@product.DietaryLabel</span> }
                @if (!string.IsNullOrWhiteSpace(product.AllergenLabel)) { <span class="border border-light px-2 py-1">@product.AllergenLabel</span> }
            </li>
            <li><span>Status</span>@stockLabel</li>
        </ul>

        @if (product.StockQuantity > 0)
        {
            <div class="d-flex w-100 flex-column flex-sm-row align-items-sm-end gap-3">
                <fieldset class="m-0 border-0 p-0">
                    <legend class="eyebrow eyebrow--light mb-2">Quantity</legend>
                    <div class="d-flex align-items-stretch">
                        <button class="button button--outline-light px-3" type="button" data-quantity-decrease aria-label="Decrease quantity" disabled>−</button>
                        <output class="d-inline-flex align-items-center justify-content-center border-top border-bottom border-light px-4 py-3 fw-bold" data-quantity-value aria-live="polite">1</output>
                        <button class="button button--outline-light px-3" type="button" data-quantity-increase aria-label="Increase quantity">+</button>
                    </div>
                </fieldset>
                <button class="button button--cream flex-grow-1" type="button" data-product-add>Add to cart</button>
            </div>
        }
        <p class="visually-hidden" data-product-status aria-live="polite"></p>
    </div>
</section>

<section class="section section--cream product-reviews" id="reviews" aria-labelledby="reviews-title">
    <div class="site-shell">
        <div class="section-heading reveal">
            <div>
                <p class="eyebrow">Product ratings</p>
                <h2 id="reviews-title">How customers rated this item.</h2>
            </div>
            <div class="review-summary">
                @if (Model.Rating.ReviewCount > 0)
                {
                    <div class="review-summary__stars" aria-label="@ReviewDisplay.Rating(Model.Rating.AverageRating) out of 5 stars">@ReviewDisplay.Stars(Model.Rating.AverageRating)</div>
                    <strong>@ReviewDisplay.Rating(Model.Rating.AverageRating)</strong>
                    <span>@Model.Rating.ReviewCount review@(Model.Rating.ReviewCount == 1 ? string.Empty : "s")</span>
                }
                else
                {
                    <p>No product ratings yet.</p>
                }
            </div>
        </div>

        @if (Model.Reviews.Count > 0)
        {
            <div class="review-list">
                @foreach (var review in Model.Reviews)
                {
                    <article class="review-card reveal">
                        <div class="review-card__stars" aria-label="@review.Rating out of 5 stars">@ReviewDisplay.Stars(review.Rating)</div>
                        <p><strong>@review.DisplayName</strong> rated this product @review.Rating out of 5<span aria-hidden="true"> · </span><time datetime="@review.CreatedAtUtc.ToString("yyyy-MM-dd")">@review.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</time></p>
                    </article>
                }
            </div>
        }
    </div>
</section>

@if (product.StockQuantity > 0)
{
    @section Scripts {
        <script>
            (() => {
                const product = document.querySelector('[data-product-details]');
                const decreaseButton = product.querySelector('[data-quantity-decrease]');
                const increaseButton = product.querySelector('[data-quantity-increase]');
                const quantityValue = product.querySelector('[data-quantity-value]');
                const addButton = product.querySelector('[data-product-add]');
                const status = product.querySelector('[data-product-status]');
                const maximumQuantity = Math.min(10, @product.StockQuantity);
                let quantity = 1;

                const updateQuantity = () => {
                    quantityValue.textContent = quantity;
                    decreaseButton.disabled = quantity === 1;
                    increaseButton.disabled = quantity === maximumQuantity;
                };
                decreaseButton.addEventListener('click', () => { quantity = Math.max(1, quantity - 1); updateQuantity(); });
                increaseButton.addEventListener('click', () => { quantity = Math.min(maximumQuantity, quantity + 1); updateQuantity(); });
                addButton.addEventListener('click', () => {
                    window.campusCart.addItem({
                        id: product.dataset.productId,
                        name: product.dataset.productName,
                        price: Number(product.dataset.productPrice),
                        quantity,
                        image: product.dataset.productImage,
                        description: product.querySelector('#product-title + p').textContent.trim(),
                        category: product.dataset.productCategory
                    });
                    addButton.textContent = 'Added';
                    status.textContent = `${quantity} × ${product.dataset.productName} added to cart.`;
                    window.setTimeout(() => { addButton.textContent = 'Add to cart'; }, 1200);
                });
            })();
        </script>
    }
}
