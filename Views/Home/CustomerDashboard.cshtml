@model CampusCoffeeSystem.Models.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
}

<section class="our-story-hero portal-surface" aria-labelledby="customer-dashboard-title">
    <div class="site-shell reveal">
        <p class="eyebrow eyebrow--light">Customer Dashboard</p>
        <h1 id="customer-dashboard-title">Welcome, @Model.DisplayName</h1>
        <p class="our-story-hero__subtitle">Your Campus Coffee shortcuts and order history in one place.</p>
    </div>
</section>

<section class="section section--paper portal-surface">
    <div class="site-shell">
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <article class="product-card portal-card h-100 reveal"><div class="product-card__body"><span class="value-card__number">01</span><div class="product-card__heading mt-5"><h3>Browse Menu</h3></div><p class="product-card__description">Explore coffee, food and current campus favourites from the database.</p><a class="button product-card__button mt-auto" asp-controller="Home" asp-action="Menu">Browse Menu</a></div></article>
            </div>
            <div class="col">
                <article class="product-card portal-card h-100 reveal"><div class="product-card__body"><span class="value-card__number">02</span><div class="product-card__heading mt-5"><h3>View Orders</h3></div><p class="product-card__description">Review @Model.Orders.Count current and previous database order@(Model.Orders.Count == 1 ? string.Empty : "s").</p><a class="button product-card__button mt-auto" href="#customer-orders">View Orders</a></div></article>
            </div>
            <div class="col">
                <article class="product-card portal-card h-100 reveal"><div class="product-card__body"><span class="value-card__number">03</span><div class="product-card__heading mt-5"><h3>Shopping Cart</h3></div><p class="product-card__description">Review products saved in your shopping cart before checkout.</p><a class="button product-card__button mt-auto" asp-controller="Home" asp-action="ShoppingCart">Shopping Cart</a></div></article>
            </div>
        </div>
    </div>
</section>

<section class="menu-catalog portal-surface" id="customer-orders" aria-labelledby="customer-orders-title">
    <div class="site-shell">
        <div class="section-heading reveal"><div><p class="eyebrow">Order history</p><h2 id="customer-orders-title">Your recent orders.</h2></div><p>@Model.Email</p></div>
        @if (Model.Orders.Count == 0)
        {
            <div class="menu-empty"><h3>No orders yet.</h3><p>Items you order will appear here.</p></div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var order in Model.Orders)
                {
                    <div class="col">
                        <article class="product-card portal-card h-100 reveal">
                            <div class="product-card__body">
                                <span class="value-card__number">@order.OrderNumber</span>
                                <div class="product-card__heading mt-5"><h3>@order.Status</h3><span class="product-card__price">@order.Total.ToString("C")</span></div>
                                <p class="product-card__description">@order.PlacedAtUtc.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</p>
                                <p class="product-card__description">@string.Join(", ", order.Items.Select(item => $"{item.ProductName} × {item.Quantity}"))</p>
                                <a class="button product-card__button mt-auto" asp-action="OrderConfirmation" asp-route-orderNumber="@order.OrderNumber">View Details</a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>
