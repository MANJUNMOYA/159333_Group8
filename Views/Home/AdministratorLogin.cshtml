@{
    ViewData["Title"] = "Administrator Login";
}

<section class="menu-closing portal-surface" aria-label="Administrator Login">
    <div class="site-shell pt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-6">
                <div class="product-card auth-card reveal">
                    <div class="product-card__body">
                        <div class="product-card__heading mb-4"><h3>Administrator sign in</h3></div>
                        <form asp-controller="PortalAuth" asp-action="Login" method="post">
                            <input name="portal" type="hidden" value="administrator" />
                            <div class="mb-4">
                                <label class="form-label cart-item__label" for="administrator-login-email">Email</label>
                                <input class="form-control form-control-lg rounded-0" id="administrator-login-email" name="email" type="email" autocomplete="email" placeholder="Enter your email" required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label cart-item__label" for="administrator-login-password">Password</label>
                                <input class="form-control form-control-lg rounded-0" id="administrator-login-password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
                            </div>
                            <button class="button product-card__button w-100" type="submit">Sign In</button>
                            @if (TempData["AuthError"] is string error)
                            {
                                <p class="auth-status is-error mt-4" role="alert">@error</p>
                            }
                        </form>
                    </div>
                </div>
                <a class="text-link text-link--light mt-4" asp-area="" asp-controller="Home" asp-action="Portal"><span aria-hidden="true">←</span> Back to portal</a>
            </div>
        </div>
    </div>
</section>
