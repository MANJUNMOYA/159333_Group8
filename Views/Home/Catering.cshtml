@{
    ViewData["Title"] = "Catering";
}

<section class="our-story-hero our-story-hero--catering page-hero--animated" data-video-hero aria-labelledby="catering-title">
    <video class="page-hero__video" data-hero-video autoplay muted loop playsinline preload="auto"
           poster="@Url.Content("~/images/home/coffee-hero-two-cups.jpg")" aria-hidden="true" tabindex="-1">
        <source src="@Url.Content("~/videos/catering.mp4")" type="video/mp4" />
    </video>
    <div class="page-hero__overlay" aria-hidden="true"></div>
    <div class="site-shell page-hero__copy">
        <p class="eyebrow eyebrow--light">Campus Coffee &amp; Catering</p>
        <h1 id="catering-title">Campus Catering</h1>
        <p class="our-story-hero__subtitle">Fresh coffee and food for every campus event.</p>
        <p class="our-story-hero__intro">
            From a focused morning meeting to a lively campus celebration, we make catering simple with freshly prepared food, quality coffee and friendly local service.
        </p>
    </div>
</section>

<section class="section section--paper" aria-labelledby="services-title">
    <div class="site-shell">
        <div class="section-heading reveal">
            <div>
                <p class="eyebrow">Made for your occasion</p>
                <h2 id="services-title">Our Catering Services</h2>
            </div>
            <p class="section-heading__copy">Flexible options for the moments that bring students, staff and the wider campus community together.</p>
        </div>

        <div class="values-grid">
            <article class="value-card reveal">
                <span class="value-card__number" aria-hidden="true">
                    <svg width="42" height="42" viewBox="0 0 42 42" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="8" y="9" width="26" height="25" rx="1" />
                        <path d="M15 6v6M27 6v6M13 18h16M14 24h6M14 29h10" />
                    </svg>
                </span>
                <h3>Meetings &amp; Workshops</h3>
                <p>Fresh coffee and light refreshments that keep meetings focused, welcoming and running smoothly.</p>
            </article>

            <article class="value-card reveal">
                <span class="value-card__number" aria-hidden="true">
                    <svg width="42" height="42" viewBox="0 0 42 42" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8 31h26M11 31V16l10-7 10 7v15M17 31v-9h8v9" />
                        <path d="M14 17h14" />
                    </svg>
                </span>
                <h3>Campus Events</h3>
                <p>Coffee and food catering for university activities, student events and community gatherings of all kinds.</p>
            </article>

            <article class="value-card reveal">
                <span class="value-card__number" aria-hidden="true">
                    <svg width="42" height="42" viewBox="0 0 42 42" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8 19h26v15H8zM6 14h30v5H6zM21 14v20" />
                        <path d="M21 14c-6 0-9-2-9-5 0-2 1.6-3 3.5-3 3.1 0 5.5 4 5.5 8ZM21 14c6 0 9-2 9-5 0-2-1.6-3-3.5-3-3.1 0-5.5 4-5.5 8Z" />
                    </svg>
                </span>
                <h3>Private Functions</h3>
                <p>Relaxed catering for birthday parties, celebrations and small gatherings shared with the people who matter.</p>
            </article>
        </div>
    </div>
</section>

<section class="section section--cream" aria-labelledby="catering-benefits-title">
    <div class="site-shell">
        <div class="section-heading reveal">
            <div>
                <p class="eyebrow">Simple and dependable</p>
                <h2 id="catering-benefits-title">Why Choose Campus Catering</h2>
            </div>
            <p class="section-heading__copy">Thoughtful service, familiar flavours and flexible support from a team that understands campus life.</p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3">
            <div class="col">
                <article class="product-card h-100 reveal">
                    <div class="product-card__body">
                        <span class="value-card__number" aria-hidden="true">✓</span>
                        <div class="product-card__heading mt-5"><h3>Freshly prepared food</h3></div>
                        <p class="product-card__description mb-0">Made with care so every order arrives fresh and ready to enjoy.</p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="product-card h-100 reveal">
                    <div class="product-card__body">
                        <span class="value-card__number" aria-hidden="true">✓</span>
                        <div class="product-card__heading mt-5"><h3>Premium coffee</h3></div>
                        <p class="product-card__description mb-0">Consistently prepared coffee for productive mornings and easy conversations.</p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="product-card h-100 reveal">
                    <div class="product-card__body">
                        <span class="value-card__number" aria-hidden="true">✓</span>
                        <div class="product-card__heading mt-5"><h3>Flexible ordering</h3></div>
                        <p class="product-card__description mb-0">Options that can be shaped around your event, schedule and group size.</p>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="product-card h-100 reveal">
                    <div class="product-card__body">
                        <span class="value-card__number" aria-hidden="true">✓</span>
                        <div class="product-card__heading mt-5"><h3>Friendly service</h3></div>
                        <p class="product-card__description mb-0">Helpful local support from enquiry through to the day of your event.</p>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="section section--paper" aria-labelledby="catering-steps-title">
    <div class="site-shell">
        <div class="section-heading reveal">
            <div>
                <p class="eyebrow">Four easy steps</p>
                <h2 id="catering-steps-title">How It Works</h2>
            </div>
            <p class="section-heading__copy">A clear, straightforward process so you can spend less time organising and more time enjoying the event.</p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3">
            <div class="col">
                <article class="product-card h-100 reveal">
                    <div class="product-card__body">
                        <span class="value-card__number">01</span>
                        <div class="product-card__heading mt-5"><h3>Submit an enquiry</h3></div>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="product-card h-100 reveal">
                    <div class="product-card__body">
                        <span class="value-card__number">02</span>
                        <div class="product-card__heading mt-5"><h3>Confirm your order</h3></div>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="product-card h-100 reveal">
                    <div class="product-card__body">
                        <span class="value-card__number">03</span>
                        <div class="product-card__heading mt-5"><h3>We prepare everything fresh</h3></div>
                    </div>
                </article>
            </div>
            <div class="col">
                <article class="product-card h-100 reveal">
                    <div class="product-card__body">
                        <span class="value-card__number">04</span>
                        <div class="product-card__heading mt-5"><h3>Enjoy your event</h3></div>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="menu-closing" id="catering-contact" aria-labelledby="catering-contact-title">
    <div class="site-shell text-center reveal">
        <p class="eyebrow eyebrow--light">Let us help</p>
        <h2 class="mx-auto" id="catering-contact-title">Ready to plan your next event?</h2>
        <p class="our-story-hero__intro mx-auto">
            Tell us what you are planning and the Campus Coffee team will help make the food and coffee the easy part.
        </p>
        <a class="button button--cream mt-5" href="@Url.Action("Create", "CateringRequests")">Contact Us</a>
    </div>
</section>
