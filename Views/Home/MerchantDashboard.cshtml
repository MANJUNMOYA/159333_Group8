@model CampusCoffeeSystem.Models.MerchantDashboardViewModel
@using CampusCoffeeSystem.Models
@{
    ViewData["Title"] = "Merchant Dashboard";
    Layout = "_MerchantDashboardLayout";

    string OrderStatusClass(string status) => status switch
    {
        OrderStatuses.Preparing => "preparing",
        OrderStatuses.Ready => "ready",
        OrderStatuses.Completed => "completed",
        OrderStatuses.Cancelled => "cancelled",
        _ => "pending"
    };

    string CustomerInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0
            ? "C"
            : string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    var merchantInitial = string.IsNullOrWhiteSpace(Model.DisplayName)
        ? "M"
        : char.ToUpperInvariant(Model.DisplayName[0]).ToString();
    var activeOrders = Model.Orders
        .Where(order => order.Status != OrderStatuses.Completed && order.Status != OrderStatuses.Cancelled)
        .ToList();
    var lowStockProducts = Model.Products
        .Where(product => product.StockQuantity <= 8)
        .OrderBy(product => product.StockQuantity)
        .ThenBy(product => product.SortOrder)
        .ToList();
    var featuredProducts = Model.Products
        .OrderBy(product => product.StockQuantity)
        .ThenBy(product => product.SortOrder)
        .Take(3)
        .ToList();
    var maximumStock = Math.Max(1, Model.Products.Select(product => product.StockQuantity).DefaultIfEmpty(1).Max());

    var localToday = DateTime.Today;
    var chartDates = Enumerable.Range(0, 7).Select(index => localToday.AddDays(index - 6)).ToArray();
    var chartStartDate = chartDates[0];
    var chartEndDate = localToday.AddDays(1);
    var sevenDayOrders = Model.Orders
        .Where(order =>
        {
            var localPlacedAt = order.PlacedAtUtc.ToLocalTime();
            return localPlacedAt.Date >= chartStartDate && localPlacedAt.Date < chartEndDate;
        })
        .ToList();
    var sevenDayTradingOrders = sevenDayOrders
        .Where(order => order.Status != OrderStatuses.Cancelled)
        .ToList();
    var sevenDayRevenue = sevenDayTradingOrders.Sum(order => order.Total);
    var averageOrderValue = sevenDayTradingOrders.Count == 0
        ? 0m
        : sevenDayRevenue / sevenDayTradingOrders.Count;
    var dailyRevenue = chartDates
        .Select(day => Model.Orders
            .Where(order => order.PlacedAtUtc.ToLocalTime().Date == day && order.Status != OrderStatuses.Cancelled)
            .Sum(order => order.Total))
        .ToArray();
    var chartMaximum = Math.Max(1m, dailyRevenue.DefaultIfEmpty(0m).Max());
    var chartPointValues = dailyRevenue
        .Select((value, index) => new
        {
            X = 20 + (index * 120),
            Y = 250d - ((double)(value / chartMaximum) * 220d)
        })
        .ToArray();
    var chartPoints = string.Join(" ", chartPointValues.Select(point =>
        $"{point.X},{point.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}"));
    var chartAreaPoints = $"20,250 {chartPoints} 740,250";

    var coffeeProductIds = Model.Products
        .Where(product => string.Equals(product.Category, "coffee", StringComparison.OrdinalIgnoreCase))
        .Select(product => product.Id)
        .ToHashSet();
    var foodProductIds = Model.Products
        .Where(product => string.Equals(product.Category, "food", StringComparison.OrdinalIgnoreCase))
        .Select(product => product.Id)
        .ToHashSet();
    var rankedSales = Model.Orders
        .Where(order => order.Status != OrderStatuses.Cancelled)
        .SelectMany(order => order.Items)
        .GroupBy(item => new { item.ProductId, item.ProductName })
        .Select(group => new
        {
            group.Key.ProductId,
            group.Key.ProductName,
            Quantity = group.Sum(item => item.Quantity)
        })
        .OrderByDescending(item => item.Quantity)
        .ThenBy(item => item.ProductName)
        .ToList();
    var topDrinks = rankedSales.Where(item => coffeeProductIds.Contains(item.ProductId)).Take(5).ToList();
    var topFood = rankedSales.Where(item => foodProductIds.Contains(item.ProductId)).Take(5).ToList();

    var completedOrderCount = Model.Orders.Count(order => order.Status == OrderStatuses.Completed);
    var completionRate = Model.Orders.Count == 0
        ? 0
        : (int)Math.Round((decimal)completedOrderCount / Model.Orders.Count * 100m);
    var availabilityRate = Model.Products.Count == 0
        ? 0
        : (int)Math.Round((decimal)Model.Products.Count(product => product.IsActive) / Model.Products.Count * 100m);
    var inventoryHealthRate = Model.Products.Count == 0
        ? 0
        : (int)Math.Round((decimal)Model.Products.Count(product => product.StockQuantity > 8) / Model.Products.Count * 100m);
    var attentionCount = activeOrders.Count + lowStockProducts.Count;

    var calendarMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var calendarOffset = (7 + (int)calendarMonth.DayOfWeek - (int)DayOfWeek.Monday) % 7;
    var calendarFirstDay = calendarMonth.AddDays(-calendarOffset);
    var calendarDays = Enumerable.Range(0, 42).Select(index => calendarFirstDay.AddDays(index)).ToList();
}

<div class="merchant-dashboard" data-merchant-dashboard>
    <form class="visually-hidden" data-dashboard-token>@Html.AntiForgeryToken()</form>

    <aside class="merchant-sidebar" aria-label="Merchant dashboard navigation">
        <a class="brand merchant-sidebar__brand" asp-area="" asp-controller="Home" asp-action="Portal" aria-label="Campus Coffee Access Portal">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 44 44"><path d="M11 16h19v9a9 9 0 0 1-9 9h-1a9 9 0 0 1-9-9v-9Z"/><path d="M30 19h2a5 5 0 0 1 0 10h-3M16 11c0-2 2-2 2-4M23 11c0-2 2-2 2-4"/></svg>
            </span>
            <span class="brand__text"><strong>CAMPUS</strong><small>MERCHANT STUDIO</small></span>
        </a>

        <div class="merchant-sidebar__label">Coffee operations</div>
        <nav class="merchant-sidebar__nav">
            <button class="is-active" type="button" data-dashboard-target="overview" aria-controls="merchant-overview" aria-current="page">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z"/></svg></span><span>Dashboard</span>
            </button>
            <button type="button" data-dashboard-target="orders" aria-controls="merchant-orders">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12l2 4v14H4V7l2-4Zm-1 5h14M9 12h6"/></svg></span><span>Orders</span><span class="merchant-nav-count">@activeOrders.Count</span>
            </button>
            <button type="button" data-dashboard-target="products" aria-controls="merchant-products">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v13H4V7Zm3 0V4h10v3M8 11h8M8 15h5"/></svg></span><span>Products</span>
            </button>
            <button type="button" data-dashboard-target="inventory" aria-controls="merchant-inventory">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10"/></svg></span><span>Inventory</span>
                @if (lowStockProducts.Count > 0)
                {
                    <span class="merchant-nav-dot" aria-label="@lowStockProducts.Count low stock items"></span>
                }
            </button>
            <button type="button" data-dashboard-target="catering" aria-controls="merchant-catering">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19h16M6 16a6 6 0 0 1 12 0H6Zm6-6V7M9 7h6"/></svg></span><span>Catering Requests</span>
            </button>
            <button type="button" data-dashboard-target="overview" data-scroll-target="sales-analytics" aria-controls="merchant-overview">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span><span>Analytics</span>
            </button>
            <button type="button" data-dashboard-target="settings" aria-controls="merchant-settings">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM19 12l2-1-2-4-2 .5L15 5l-.5-2h-5L9 5 7 7.5 5 7l-2 4 2 1-2 1 2 4 2-.5L9 19l.5 2h5l.5-2 2-2.5 2 .5 2-4-2-1Z"/></svg></span><span>Settings</span>
            </button>
            <a asp-area="" asp-controller="Home" asp-action="Portal" data-merchant-logout>
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 5H4v14h6M14 8l4 4-4 4M8 12h10"/></svg></span><span>Logout</span>
            </a>
        </nav>

        <div class="merchant-sidebar__profile">
            <span class="merchant-avatar merchant-avatar--small" aria-hidden="true">@merchantInitial</span>
            <div><strong>@Model.DisplayName</strong><span>@Model.Email</span></div>
        </div>
    </aside>

    <main class="merchant-main" id="merchant-main">
        <header class="merchant-header">
            <div class="merchant-header__welcome">
                <p class="merchant-kicker">Merchant workspace</p>
                <h1>Welcome back, @Model.DisplayName</h1>
                <time data-current-date></time>
            </div>
            <div class="merchant-header__tools">
                <label class="merchant-search">
                    <span class="visually-hidden">Search dashboard</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
                    <input type="search" placeholder="Search workspace" data-dashboard-search />
                    <kbd>Ctrl K</kbd>
                </label>
                <button class="merchant-icon-button" type="button" aria-label="View current database notifications" data-notification-button>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></svg>
                    @if (attentionCount > 0) { <span></span> }
                </button>
                <button class="merchant-profile-button" type="button" data-dashboard-target="settings" aria-label="Open merchant settings">
                    <span class="merchant-avatar" aria-hidden="true">@merchantInitial</span>
                    <span><strong>@Model.DisplayName</strong><small>@Model.Email</small></span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"/></svg>
                </button>
            </div>
        </header>

        <p class="merchant-notice" data-dashboard-status aria-live="polite" hidden></p>

        <section class="merchant-panel is-active" id="merchant-overview" data-dashboard-panel="overview" aria-labelledby="overview-title">
            <div class="merchant-section-heading merchant-reveal">
                <div><p class="merchant-kicker">Business overview</p><h2 id="overview-title">Today at a glance.</h2></div>
                <p>Live orders, menu availability and stock from the Campus Coffee database.</p>
            </div>

            <div class="merchant-summary-grid">
                <article class="merchant-summary-card merchant-reveal">
                    <div class="merchant-summary-card__top"><span>Today’s Orders</span><span class="merchant-trend">SQL Server</span></div>
                    <strong data-count-up="@Model.TodayOrderCount">@Model.TodayOrderCount</strong><small>Orders placed today</small>
                    <span class="merchant-summary-card__mark">01</span>
                </article>
                <article class="merchant-summary-card merchant-reveal">
                    <div class="merchant-summary-card__top"><span>Active Orders</span><span class="merchant-trend">@activeOrders.Count in queue</span></div>
                    <strong data-count-up="@activeOrders.Count">@activeOrders.Count</strong><small>Not completed or cancelled</small>
                    <span class="merchant-summary-card__mark">02</span>
                </article>
                <article class="merchant-summary-card merchant-summary-card--espresso merchant-reveal">
                    <div class="merchant-summary-card__top"><span>Today’s Revenue</span><span class="merchant-trend merchant-trend--light">Live total</span></div>
                    <strong>@CurrencyFormatter.NzDollars(Model.TodayRevenue)</strong><small>Excluding cancelled orders</small>
                    <span class="merchant-summary-card__mark">03</span>
                </article>
                <article class="merchant-summary-card merchant-reveal">
                    <div class="merchant-summary-card__top"><span>Low Stock Items</span><span class="merchant-trend merchant-trend--warn">Needs care</span></div>
                    <strong data-count-up="@lowStockProducts.Count">@lowStockProducts.Count</strong><small>Eight units or fewer</small>
                    <span class="merchant-summary-card__mark">04</span>
                </article>
            </div>

            <section class="merchant-analytics-card merchant-reveal" id="sales-analytics" aria-labelledby="analytics-title">
                <div class="merchant-card-heading">
                    <div><p class="merchant-kicker">Sales analytics</p><h2 id="analytics-title">The last seven database days.</h2></div>
                    <div class="merchant-period-switch" aria-label="Chart period">
                        <button class="is-active" type="button">7 days</button>
                        <button type="button" disabled title="A wider database query is not part of the current view model.">30 days</button>
                        <button type="button" disabled title="A wider database query is not part of the current view model.">90 days</button>
                    </div>
                </div>
                <div class="merchant-analytics-layout">
                    <div class="merchant-chart-wrap" aria-label="Revenue recorded in the database over the last seven days">
                        <div class="merchant-chart-scale" aria-hidden="true"><span>@CurrencyFormatter.NzDollars(chartMaximum)</span><span>@CurrencyFormatter.NzDollars(chartMaximum * .75m)</span><span>@CurrencyFormatter.NzDollars(chartMaximum * .5m)</span><span>@CurrencyFormatter.NzDollars(chartMaximum * .25m)</span><span>NZ$0.00</span></div>
                        <svg class="merchant-line-chart" viewBox="0 0 760 280" role="img" aria-labelledby="chart-title chart-description">
                            <title id="chart-title">Seven-day revenue</title><desc id="chart-description">Daily non-cancelled order revenue calculated from the current database records.</desc>
                            <defs><linearGradient id="merchant-chart-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#a64b2a" stop-opacity=".24"/><stop offset="1" stop-color="#a64b2a" stop-opacity="0"/></linearGradient></defs>
                            <g class="merchant-chart-grid"><path d="M20 30H740M20 85H740M20 140H740M20 195H740M20 250H740"/></g>
                            <polygon class="merchant-chart-area" points="@chartAreaPoints" />
                            <polyline class="merchant-chart-line" points="@chartPoints" />
                            <g class="merchant-chart-points">
                                @foreach (var point in chartPointValues)
                                {
                                    <circle cx="@point.X" cy="@point.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" r="5" />
                                }
                            </g>
                        </svg>
                        <div class="merchant-chart-labels">
                            @foreach (var day in chartDates) { <span>@day.ToString("ddd d")</span> }
                        </div>
                    </div>
                    <div class="merchant-analytics-metrics">
                        <article><span>Revenue</span><strong>@CurrencyFormatter.NzDollars(sevenDayRevenue)</strong><small>Non-cancelled database orders</small></article>
                        <article><span>Orders</span><strong>@sevenDayOrders.Count</strong><small>Placed during the seven-day window</small></article>
                        <article><span>Average Order Value</span><strong>@CurrencyFormatter.NzDollars(averageOrderValue)</strong><small>Across non-cancelled orders</small></article>
                    </div>
                </div>
            </section>

            <section class="merchant-content-card merchant-reveal" aria-labelledby="recent-orders-title">
                <div class="merchant-card-heading merchant-card-heading--bordered">
                    <div><p class="merchant-kicker">Recent orders</p><h2 id="recent-orders-title">Fresh from the counter.</h2></div>
                    <button class="merchant-text-button" type="button" data-dashboard-link="orders">View all orders <span>↗</span></button>
                </div>
                <div class="table-responsive">
                    <table class="merchant-table merchant-table--airy">
                        <thead><tr><th>Order ID</th><th>Customer</th><th>Items</th><th>Status</th><th>Time</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (Model.Orders.Count == 0)
                            {
                                <tr><td colspan="6">No customer orders are currently stored in the database.</td></tr>
                            }
                            @foreach (var order in Model.Orders.Take(4))
                            {
                                var itemSummary = string.Join(", ", order.Items.Select(item => $"{item.ProductName} ×{item.Quantity}"));
                                <tr data-search-item>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td><span class="merchant-customer"><span>@CustomerInitials(order.CustomerName)</span>@order.CustomerName</span></td>
                                    <td>@itemSummary</td>
                                    <td><span class="merchant-badge merchant-badge--@OrderStatusClass(order.Status)">@order.Status</span></td>
                                    <td>@order.PlacedAtUtc.ToLocalTime().ToString("HH:mm")</td>
                                    <td><button class="merchant-row-action" type="button" data-view-order="@order.Id">View</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="merchant-dashboard-section" aria-labelledby="inventory-overview-title">
                <div class="merchant-section-heading merchant-reveal">
                    <div><p class="merchant-kicker">Inventory overview</p><h2 id="inventory-overview-title">Stock, thoughtfully managed.</h2></div>
                    <button class="merchant-text-button" type="button" data-dashboard-link="inventory">Open inventory <span>↗</span></button>
                </div>
                @if (featuredProducts.Count == 0)
                {
                    <div class="merchant-content-card merchant-reveal"><p>No products are currently stored in the database.</p></div>
                }
                else
                {
                    <div class="merchant-product-grid">
                        @foreach (var product in featuredProducts)
                        {
                            var stockClass = product.StockQuantity == 0 ? "critical" : product.StockQuantity <= 8 ? "low" : "stock";
                            var stockLabel = product.StockQuantity == 0 ? "Sold Out" : product.StockQuantity <= 8 ? "Almost Out" : "Healthy";
                            var stockProgress = Math.Min(100, (int)Math.Round((decimal)product.StockQuantity / maximumStock * 100m));
                            var imagePath = string.IsNullOrWhiteSpace(product.ImagePath) ? "/images/menu/Campus Flat White.jpg" : product.ImagePath;
                            <article class="merchant-product-card merchant-reveal" data-featured-product data-product-id="@product.Id" data-featured-stock="@product.StockQuantity">
                                <div class="merchant-product-card__image"><img src="@imagePath" alt="@product.Name" /></div>
                                <div class="merchant-product-card__body">
                                    <div class="merchant-product-card__heading"><div><span>@product.DisplayCategory</span><h3>@product.Name</h3></div><span class="merchant-badge merchant-badge--@stockClass" data-featured-status>@stockLabel</span></div>
                                    <div class="merchant-stock-line"><span><strong data-featured-count>@product.StockQuantity</strong> left</span><span>Database stock</span></div>
                                    <div class="merchant-progress merchant-progress--@stockClass"><span style="width:@stockProgress%"></span></div>
                                    <div class="merchant-card-actions">
                                        <button type="button" data-featured-action="manage">Manage</button>
                                        <button type="button" data-featured-action="restock">Restock +10</button>
                                        <button type="button" data-featured-action="view" data-view-url="@Url.Action("ProductDetails", "Home", new { id = product.Id })" @(product.IsActive ? null : "disabled")>View</button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <div class="merchant-split-grid">
                <section class="merchant-content-card merchant-reveal" aria-labelledby="best-sellers-title">
                    <div class="merchant-card-heading merchant-card-heading--bordered"><div><p class="merchant-kicker">Database best sellers</p><h2 id="best-sellers-title">Campus favourites.</h2></div></div>
                    <div class="merchant-ranking-columns">
                        <div>
                            <h3>Top drinks</h3>
                            @if (topDrinks.Count == 0)
                            {
                                <p>No drink sales are stored yet.</p>
                            }
                            else
                            {
                                var maximumDrinkSales = topDrinks.Max(item => item.Quantity);
                                <ol class="merchant-ranking-list">
                                    @for (var index = 0; index < topDrinks.Count; index++)
                                    {
                                        var item = topDrinks[index];
                                        var width = (int)Math.Round((decimal)item.Quantity / maximumDrinkSales * 100m);
                                        <li><span class="merchant-rank">@(index + 1)</span><span><strong>@item.ProductName</strong><small>@item.Quantity sold</small></span><span class="merchant-rank-bar"><i style="width:@width%"></i></span></li>
                                    }
                                </ol>
                            }
                        </div>
                        <div>
                            <h3>Top food</h3>
                            @if (topFood.Count == 0)
                            {
                                <p>No food sales are stored yet.</p>
                            }
                            else
                            {
                                var maximumFoodSales = topFood.Max(item => item.Quantity);
                                <ol class="merchant-ranking-list">
                                    @for (var index = 0; index < topFood.Count; index++)
                                    {
                                        var item = topFood[index];
                                        var width = (int)Math.Round((decimal)item.Quantity / maximumFoodSales * 100m);
                                        <li><span class="merchant-rank">@(index + 1)</span><span><strong>@item.ProductName</strong><small>@item.Quantity sold</small></span><span class="merchant-rank-bar"><i style="width:@width%"></i></span></li>
                                    }
                                </ol>
                            }
                        </div>
                    </div>
                </section>

                <section class="merchant-content-card merchant-reveal" id="merchant-notifications" aria-labelledby="notifications-title">
                    <div class="merchant-card-heading merchant-card-heading--bordered"><div><p class="merchant-kicker">Notifications</p><h2 id="notifications-title">Needs your attention.</h2></div><span class="merchant-unread-count">@attentionCount current</span></div>
                    <div class="merchant-notification-list">
                        @if (attentionCount == 0)
                        {
                            <p>There are no active order or low-stock notifications in the database.</p>
                        }
                        @foreach (var product in lowStockProducts.Take(2))
                        {
                            <article><span class="merchant-notification-icon merchant-notification-icon--warning"><svg viewBox="0 0 24 24"><path d="M12 3 2 21h20L12 3Zm0 6v5m0 3v1"/></svg></span><div><strong>Low stock warning</strong><p>@product.Name has @product.StockQuantity unit@(product.StockQuantity == 1 ? "" : "s") remaining.</p><time>Current database stock</time></div></article>
                        }
                        @foreach (var order in activeOrders.Take(2))
                        {
                            <article><span class="merchant-notification-icon merchant-notification-icon--coffee"><svg viewBox="0 0 24 24"><path d="M4 8h13v6a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6V8Zm13 2h2a3 3 0 0 1 0 6h-2M8 4v2m4-2v2"/></svg></span><div><strong>@order.OrderNumber is @order.Status.ToLowerInvariant()</strong><p>@order.CustomerName · @order.Items.Sum(item => item.Quantity) item(s) · @CurrencyFormatter.NzDollars(order.Total)</p><time>@order.PlacedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</time></div></article>
                        }
                    </div>
                </section>
            </div>

            <section class="merchant-dashboard-section" aria-labelledby="quick-actions-title">
                <div class="merchant-section-heading merchant-reveal"><div><p class="merchant-kicker">Quick actions</p><h2 id="quick-actions-title">Move the day forward.</h2></div></div>
                <div class="merchant-quick-actions">
                    <button type="button" data-dashboard-link="products" data-trigger-add-product><span>+</span><strong>Add Product</strong></button>
                    <button type="button" data-dashboard-link="inventory"><span>↗</span><strong>Receive Stock</strong></button>
                    <button type="button" data-dashboard-link="orders"><span>✓</span><strong>Process Orders</strong></button>
                    <button type="button" data-dashboard-target="overview" data-scroll-target="sales-analytics"><span>⌁</span><strong>View Analytics</strong></button>
                    <button type="button" data-refresh-dashboard><span>↻</span><strong>Refresh Database View</strong></button>
                </div>
            </section>

            <div class="merchant-split-grid merchant-split-grid--lower">
                <section class="merchant-content-card merchant-reveal" aria-labelledby="calendar-title">
                    <div class="merchant-card-heading merchant-card-heading--bordered"><div><p class="merchant-kicker">Catering calendar</p><h2 id="calendar-title">@calendarMonth.ToString("MMMM yyyy")</h2></div><div class="merchant-calendar-controls"><button type="button" aria-label="Previous month" disabled>←</button><button type="button" aria-label="Next month" disabled>→</button></div></div>
                    <div class="merchant-calendar"><div class="merchant-calendar__weekdays"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div class="merchant-calendar__days">
                        @foreach (var day in calendarDays)
                        {
                            var dayClass = day.Month != calendarMonth.Month ? "is-muted" : day.Date == DateTime.Today ? "is-today" : string.Empty;
                            <span class="@dayClass">@day.Day</span>
                        }
                    </div></div>
                    <div class="merchant-booking"><span>—</span><div><strong>No catering bookings</strong><small>A catering request table has not been added to the database yet.</small></div><span class="merchant-badge merchant-badge--pending">Empty</span></div>
                </section>

                <section class="merchant-content-card merchant-reveal" aria-labelledby="performance-title">
                    <div class="merchant-card-heading merchant-card-heading--bordered"><div><p class="merchant-kicker">Performance</p><h2 id="performance-title">Database health at a glance.</h2></div></div>
                    <div class="merchant-performance-grid">
                        <article><div class="merchant-ring" style="--progress:@completionRate"><span>@completionRate<small>%</small></span></div><strong>Orders Completed</strong><small>@completedOrderCount of @Model.Orders.Count stored orders</small></article>
                        <article><div class="merchant-ring" style="--progress:@availabilityRate"><span>@availabilityRate<small>%</small></span></div><strong>Menu Availability</strong><small>@Model.Products.Count(product => product.IsActive) of @Model.Products.Count products active</small></article>
                        <article><div class="merchant-ring merchant-ring--sage" style="--progress:@inventoryHealthRate"><span>@inventoryHealthRate<small>%</small></span></div><strong>Inventory Health</strong><small>@Model.Products.Count(product => product.StockQuantity > 8) products above low-stock level</small></article>
                    </div>
                </section>
            </div>
        </section>

        <section class="merchant-panel" id="merchant-orders" data-dashboard-panel="orders" aria-labelledby="orders-title" hidden>
            <div class="merchant-section-heading"><div><p class="merchant-kicker">Order studio</p><h2 id="orders-title">Orders in motion.</h2></div><p>Every card below comes from the current database. Status changes are saved immediately.</p></div>
            <div class="merchant-order-grid">
                @if (Model.Orders.Count == 0)
                {
                    <div class="merchant-content-card"><p>No customer orders are currently stored in the database.</p></div>
                }
                @foreach (var order in Model.Orders)
                {
                    <article class="merchant-order-card" id="merchant-order-@order.Id" data-order-card data-order-id="@order.Id" data-order-number="@order.OrderNumber" data-search-item>
                        <div class="merchant-order-card__heading"><div><span>@order.CustomerName · @order.PlacedAtUtc.ToLocalTime().ToString("dd MMM HH:mm")</span><h3>@order.OrderNumber</h3></div><span class="merchant-badge merchant-badge--@OrderStatusClass(order.Status)" data-order-status>@order.Status</span></div>
                        <ul>
                            @foreach (var item in order.Items)
                            {
                                <li><span>@item.ProductName × @item.Quantity</span><strong>@CurrencyFormatter.NzDollars(item.UnitPrice * item.Quantity)</strong></li>
                            }
                        </ul>
                        @if (string.Equals(order.OrderMethod, "Delivery", StringComparison.OrdinalIgnoreCase))
                        {
                            <p class="merchant-order-card__delivery"><strong>Delivery:</strong> @order.DeliveryAddressLine1@if (!string.IsNullOrWhiteSpace(order.DeliveryAddressLine2)) { <text>, @order.DeliveryAddressLine2</text> }, @order.DeliveryCity @order.DeliveryPostcode</p>
                        }
                        <div class="merchant-order-card__total"><span>Total</span><strong>@CurrencyFormatter.NzDollars(order.Total)</strong></div>
                        @if (order.Status != OrderStatuses.Completed && order.Status != OrderStatuses.Cancelled)
                        {
                            <div class="merchant-card-actions">
                                @if (order.Status == OrderStatuses.Pending)
                                {
                                    <button type="button" data-order-action="Preparing">Start preparing</button>
                                }
                                @if (order.Status == OrderStatuses.Preparing)
                                {
                                    <button type="button" data-order-action="Ready">Mark ready</button>
                                }
                                <button type="button" data-order-action="Completed">Complete</button>
                                <button type="button" data-order-action="Cancelled">Cancel</button>
                            </div>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="merchant-panel" id="merchant-products" data-dashboard-panel="products" aria-labelledby="products-title" hidden>
            <div class="merchant-section-heading"><div><p class="merchant-kicker">Menu collection</p><h2 id="products-title">Products, beautifully simple.</h2></div><button class="merchant-primary-button" type="button" data-add-product>+ Add Product</button></div>
            <div class="merchant-content-card"><div class="table-responsive"><table class="merchant-table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead><tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr><td colspan="5">No products are currently stored in the database.</td></tr>
                }
                @foreach (var product in Model.Products)
                {
                    <tr data-product-row data-product-id="@product.Id" data-product-name="@product.Name" data-search-item><td><strong>@product.Name</strong></td><td>@product.DisplayCategory</td><td>@CurrencyFormatter.NzDollars(product.Price)</td><td><span class="merchant-badge merchant-badge--@(product.IsActive ? "active" : "disabled")" data-product-status>@(product.IsActive ? "Active" : "Disabled")</span></td><td><div class="merchant-table__actions"><button type="button" data-product-action="stock">Manage stock</button><button type="button" data-product-action="toggle">@(product.IsActive ? "Disable" : "Enable")</button></div></td></tr>
                }
            </tbody></table></div></div>
        </section>

        <section class="merchant-panel" id="merchant-inventory" data-dashboard-panel="inventory" aria-labelledby="inventory-title" hidden>
            <div class="merchant-section-heading"><div><p class="merchant-kicker">Stock room</p><h2 id="inventory-title">Inventory with intention.</h2></div><p>Quantities below are read from and written to SQL Server.</p></div>
            <div class="merchant-content-card"><div class="table-responsive"><table class="merchant-table"><thead><tr><th>Product</th><th>Current Stock</th><th>Status</th><th>Action</th></tr></thead><tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr><td colspan="4">No product inventory is currently stored in the database.</td></tr>
                }
                @foreach (var product in Model.Products)
                {
                    var stockClass = product.StockQuantity == 0 ? "critical" : product.StockQuantity <= 8 ? "low" : "stock";
                    var stockLabel = product.StockQuantity == 0 ? "Sold out" : product.StockQuantity <= 8 ? "Low stock" : "In stock";
                    <tr id="merchant-inventory-product-@product.Id" data-inventory-row data-product-id="@product.Id" data-product-name="@product.Name" data-search-item><td><strong>@product.Name</strong></td><td><span data-stock-count>@product.StockQuantity</span></td><td><span class="merchant-badge merchant-badge--@stockClass" data-stock-status>@stockLabel</span></td><td><div class="merchant-table__actions"><button type="button" data-inventory-action="restock">Restock +10</button><button type="button" data-inventory-action="edit">Set quantity</button></div></td></tr>
                }
            </tbody></table></div></div>
        </section>

        <section class="merchant-panel" id="merchant-catering" data-dashboard-panel="catering" aria-labelledby="catering-requests-title" hidden>
            <div class="merchant-section-heading"><div><p class="merchant-kicker">Gatherings</p><h2 id="catering-requests-title">Catering requests.</h2></div><p>Thoughtful service for the next campus occasion.</p></div>
            <div class="merchant-content-card">
                <div class="table-responsive"><table class="merchant-table"><thead><tr><th>Event</th><th>Date</th><th>Guests</th><th>Status</th><th>Actions</th></tr></thead><tbody><tr><td colspan="5">No catering request table exists in the current database, so there are no requests to display.</td></tr></tbody></table></div>
            </div>
        </section>

        <section class="merchant-panel" id="merchant-settings" data-dashboard-panel="settings" aria-labelledby="settings-title" hidden>
            <div class="merchant-section-heading"><div><p class="merchant-kicker">Workspace preferences</p><h2 id="settings-title">Settings.</h2></div><p>Authenticated account details from ASP.NET Core Identity.</p></div>
            <div class="merchant-settings-grid">
                <section class="merchant-content-card"><h3>Service preferences</h3><p>No merchant preference fields are stored in the current database.</p><label class="merchant-setting"><span><strong>New order alerts</strong><small>Unavailable until preferences are persisted.</small></span><input type="checkbox" disabled /><i></i></label><label class="merchant-setting"><span><strong>Low stock reminders</strong><small>Unavailable until preferences are persisted.</small></span><input type="checkbox" disabled /><i></i></label><label class="merchant-setting"><span><strong>Daily summary</strong><small>Unavailable until report storage is implemented.</small></span><input type="checkbox" disabled /><i></i></label></section>
                <section class="merchant-content-card merchant-settings-profile"><span class="merchant-avatar merchant-avatar--large">@merchantInitial</span><h3>@Model.DisplayName</h3><p>@Model.Email</p><span class="merchant-badge merchant-badge--active">Authenticated merchant</span></section>
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <script src="~/js/merchant-dashboard.js" asp-append-version="true"></script>
}
