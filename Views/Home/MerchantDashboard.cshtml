@{
    ViewData["Title"] = "Merchant Dashboard";
    Layout = "_MerchantDashboardLayout";
}

<div class="merchant-dashboard" data-merchant-dashboard>
    <aside class="merchant-sidebar" aria-label="Merchant dashboard navigation">
        <a class="brand merchant-sidebar__brand" asp-area="" asp-controller="Home" asp-action="Portal" aria-label="Campus Coffee Access Portal">
            <span class="brand__mark" aria-hidden="true">
                <svg viewBox="0 0 44 44"><path d="M11 16h19v9a9 9 0 0 1-9 9h-1a9 9 0 0 1-9-9v-9Z"/><path d="M30 19h2a5 5 0 0 1 0 10h-3M16 11c0-2 2-2 2-4M23 11c0-2 2-2 2-4"/></svg>
            </span>
            <span class="brand__text"><strong>CAMPUS</strong><small>MERCHANT STUDIO</small></span>
        </a>

        <div class="merchant-sidebar__label">Coffee operations</div>
        <nav class="merchant-sidebar__nav">
            <button class="is-active" type="button" data-dashboard-target="overview" aria-controls="merchant-overview" aria-current="page">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z"/></svg></span><span>Dashboard</span>
            </button>
            <button type="button" data-dashboard-target="orders" aria-controls="merchant-orders">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12l2 4v14H4V7l2-4Zm-1 5h14M9 12h6"/></svg></span><span>Orders</span><span class="merchant-nav-count">5</span>
            </button>
            <button type="button" data-dashboard-target="products" aria-controls="merchant-products">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v13H4V7Zm3 0V4h10v3M8 11h8M8 15h5"/></svg></span><span>Products</span>
            </button>
            <button type="button" data-dashboard-target="inventory" aria-controls="merchant-inventory">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4-8-4Zm0 0v10l8 4 8-4V7M12 11v10"/></svg></span><span>Inventory</span><span class="merchant-nav-dot" aria-label="3 low stock items"></span>
            </button>
            <button type="button" data-dashboard-target="catering" aria-controls="merchant-catering">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19h16M6 16a6 6 0 0 1 12 0H6Zm6-6V7M9 7h6"/></svg></span><span>Catering Requests</span><span class="merchant-nav-count">2</span>
            </button>
            <button type="button" data-dashboard-target="overview" data-scroll-target="sales-analytics" aria-controls="merchant-overview">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span><span>Analytics</span>
            </button>
            <button type="button" data-dashboard-target="settings" aria-controls="merchant-settings">
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM19 12l2-1-2-4-2 .5L15 5l-.5-2h-5L9 5 7 7.5 5 7l-2 4 2 1-2 1 2 4 2-.5L9 19l.5 2h5l.5-2 2-2.5 2 .5 2-4-2-1Z"/></svg></span><span>Settings</span>
            </button>
            <a asp-area="" asp-controller="Home" asp-action="Portal" data-merchant-logout>
                <span class="merchant-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 5H4v14h6M14 8l4 4-4 4M8 12h10"/></svg></span><span>Logout</span>
            </a>
        </nav>

        <div class="merchant-sidebar__profile">
            <span class="merchant-avatar merchant-avatar--small" aria-hidden="true">M</span>
            <div><strong>Campus Coffee</strong><span>merchant@test.com</span></div>
        </div>
    </aside>

    <main class="merchant-main" id="merchant-main">
        <header class="merchant-header">
            <div class="merchant-header__welcome">
                <p class="merchant-kicker">Merchant workspace</p>
                <h1>Welcome back, Merchant</h1>
                <time data-current-date></time>
            </div>
            <div class="merchant-header__tools">
                <label class="merchant-search">
                    <span class="visually-hidden">Search dashboard</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
                    <input type="search" placeholder="Search workspace" data-dashboard-search />
                    <kbd>⌘ K</kbd>
                </label>
                <button class="merchant-icon-button" type="button" aria-label="View notifications" data-notification-button>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></svg><span></span>
                </button>
                <button class="merchant-profile-button" type="button" data-dashboard-target="settings" aria-label="Open merchant settings">
                    <span class="merchant-avatar" aria-hidden="true">M</span>
                    <span><strong>Merchant</strong><small>Campus Coffee</small></span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"/></svg>
                </button>
            </div>
        </header>

        <p class="merchant-notice" data-dashboard-status aria-live="polite" hidden></p>

        <section class="merchant-panel is-active" id="merchant-overview" data-dashboard-panel="overview" aria-labelledby="overview-title">
            <div class="merchant-section-heading merchant-reveal">
                <div><p class="merchant-kicker">Business overview</p><h2 id="overview-title">Today at a glance.</h2></div>
                <p>A calm view of everything moving through Campus Coffee today.</p>
            </div>

            <div class="merchant-summary-grid">
                <article class="merchant-summary-card merchant-reveal">
                    <div class="merchant-summary-card__top"><span>Today’s Orders</span><span class="merchant-trend merchant-trend--up">↗ 12%</span></div>
                    <strong data-count-up="18">0</strong><small>Across coffee, food and catering</small>
                    <span class="merchant-summary-card__mark">01</span>
                </article>
                <article class="merchant-summary-card merchant-reveal">
                    <div class="merchant-summary-card__top"><span>Pending Orders</span><span class="merchant-trend">5 active</span></div>
                    <strong data-count-up="5">0</strong><small>Average wait time: 6 minutes</small>
                    <span class="merchant-summary-card__mark">02</span>
                </article>
                <article class="merchant-summary-card merchant-summary-card--espresso merchant-reveal">
                    <div class="merchant-summary-card__top"><span>Today’s Revenue</span><span class="merchant-trend merchant-trend--light">↗ 8.4%</span></div>
                    <strong><span>$</span><span data-count-up="468">0</span></strong><small>Tracking above weekday average</small>
                    <span class="merchant-summary-card__mark">03</span>
                </article>
                <article class="merchant-summary-card merchant-reveal">
                    <div class="merchant-summary-card__top"><span>Low Stock Items</span><span class="merchant-trend merchant-trend--warn">Needs care</span></div>
                    <strong data-count-up="3">0</strong><small>Restock before tomorrow morning</small>
                    <span class="merchant-summary-card__mark">04</span>
                </article>
            </div>

            <section class="merchant-analytics-card merchant-reveal" id="sales-analytics" aria-labelledby="analytics-title">
                <div class="merchant-card-heading">
                    <div><p class="merchant-kicker">Sales analytics</p><h2 id="analytics-title">A strong week brewing.</h2></div>
                    <div class="merchant-period-switch" aria-label="Chart period"><button class="is-active" type="button">7 days</button><button type="button">30 days</button><button type="button">90 days</button></div>
                </div>
                <div class="merchant-analytics-layout">
                    <div class="merchant-chart-wrap" aria-label="Static weekly revenue line chart">
                        <div class="merchant-chart-scale" aria-hidden="true"><span>$800</span><span>$600</span><span>$400</span><span>$200</span><span>$0</span></div>
                        <svg class="merchant-line-chart" viewBox="0 0 760 280" role="img" aria-labelledby="chart-title chart-description">
                            <title id="chart-title">Weekly revenue</title><desc id="chart-description">Revenue rises from Monday through Sunday with its highest point on Saturday.</desc>
                            <defs><linearGradient id="merchant-chart-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#a64b2a" stop-opacity=".24"/><stop offset="1" stop-color="#a64b2a" stop-opacity="0"/></linearGradient></defs>
                            <g class="merchant-chart-grid"><path d="M20 30H740M20 85H740M20 140H740M20 195H740M20 250H740"/></g>
                            <path class="merchant-chart-area" d="M20 205 C70 195 85 185 130 188 S205 145 240 155 S310 118 350 128 S420 90 460 102 S535 72 570 82 S645 42 680 54 S720 45 740 35 L740 250 L20 250Z"/>
                            <path class="merchant-chart-line" d="M20 205 C70 195 85 185 130 188 S205 145 240 155 S310 118 350 128 S420 90 460 102 S535 72 570 82 S645 42 680 54 S720 45 740 35"/>
                            <g class="merchant-chart-points"><circle cx="20" cy="205" r="5"/><circle cx="130" cy="188" r="5"/><circle cx="240" cy="155" r="5"/><circle cx="350" cy="128" r="5"/><circle cx="460" cy="102" r="5"/><circle cx="570" cy="82" r="5"/><circle cx="680" cy="54" r="5"/><circle cx="740" cy="35" r="5"/></g>
                        </svg>
                        <div class="merchant-chart-labels"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
                    </div>
                    <div class="merchant-analytics-metrics">
                        <article><span>Revenue</span><strong>$3,248</strong><small>+8.4% this week</small></article>
                        <article><span>Orders</span><strong>126</strong><small>18 per day average</small></article>
                        <article><span>Average Order Value</span><strong>$25.78</strong><small>+$1.40 from last week</small></article>
                    </div>
                </div>
            </section>

            <section class="merchant-content-card merchant-reveal" aria-labelledby="recent-orders-title">
                <div class="merchant-card-heading merchant-card-heading--bordered">
                    <div><p class="merchant-kicker">Recent orders</p><h2 id="recent-orders-title">Fresh from the counter.</h2></div>
                    <button class="merchant-text-button" type="button" data-dashboard-link="orders">View all orders <span>↗</span></button>
                </div>
                <div class="table-responsive">
                    <table class="merchant-table merchant-table--airy">
                        <thead><tr><th>Order ID</th><th>Customer</th><th>Items</th><th>Status</th><th>Time</th><th>Actions</th></tr></thead>
                        <tbody>
                            <tr data-search-item><td><strong>#1001</strong></td><td><span class="merchant-customer"><span>EM</span>Emma</span></td><td>2 Latte</td><td><span class="merchant-badge merchant-badge--preparing">Preparing</span></td><td>09:20</td><td><button class="merchant-row-action" type="button" data-view-order="#1001">View</button></td></tr>
                            <tr data-search-item><td><strong>#1002</strong></td><td><span class="merchant-customer"><span>JA</span>Jack</span></td><td>Flat White</td><td><span class="merchant-badge merchant-badge--ready">Ready</span></td><td>09:34</td><td><button class="merchant-row-action" type="button" data-view-order="#1002">View</button></td></tr>
                            <tr data-search-item><td><strong>#1003</strong></td><td><span class="merchant-customer"><span>OL</span>Olivia</span></td><td>Croissant</td><td><span class="merchant-badge merchant-badge--completed">Completed</span></td><td>09:41</td><td><button class="merchant-row-action" type="button" data-view-order="#1003">View</button></td></tr>
                            <tr data-search-item><td><strong>#1004</strong></td><td><span class="merchant-customer"><span>NO</span>Noah</span></td><td>Cold Brew + Loaf</td><td><span class="merchant-badge merchant-badge--pending">Pending</span></td><td>09:47</td><td><button class="merchant-row-action" type="button" data-view-order="#1004">View</button></td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="merchant-dashboard-section" aria-labelledby="inventory-overview-title">
                <div class="merchant-section-heading merchant-reveal">
                    <div><p class="merchant-kicker">Inventory overview</p><h2 id="inventory-overview-title">Stock, thoughtfully managed.</h2></div>
                    <button class="merchant-text-button" type="button" data-dashboard-link="inventory">Open inventory <span>↗</span></button>
                </div>
                <div class="merchant-product-grid">
                    <article class="merchant-product-card merchant-reveal" data-featured-stock="28">
                        <div class="merchant-product-card__image"><img src="~/images/menu/Campus Flat White.jpg" alt="Campus Flat White" /></div>
                        <div class="merchant-product-card__body"><div class="merchant-product-card__heading"><div><span>Coffee</span><h3>Campus Flat White</h3></div><span class="merchant-badge merchant-badge--stock" data-featured-status>Healthy</span></div><div class="merchant-stock-line"><span><strong data-featured-count>28</strong> left</span><span>70%</span></div><div class="merchant-progress"><span style="width:70%"></span></div><div class="merchant-card-actions"><button type="button" data-featured-action="edit">Edit</button><button type="button" data-featured-action="restock">Restock</button><button type="button" data-featured-action="view">View</button></div></div>
                    </article>
                    <article class="merchant-product-card merchant-reveal" data-featured-stock="8">
                        <div class="merchant-product-card__image"><img src="~/images/menu/Vanilla Cold Brew.jpg" alt="Vanilla Cold Brew" /></div>
                        <div class="merchant-product-card__body"><div class="merchant-product-card__heading"><div><span>Cold coffee</span><h3>Vanilla Cold Brew</h3></div><span class="merchant-badge merchant-badge--low" data-featured-status>Almost Out</span></div><div class="merchant-stock-line"><span><strong data-featured-count>8</strong> left</span><span>20%</span></div><div class="merchant-progress merchant-progress--low"><span style="width:20%"></span></div><div class="merchant-card-actions"><button type="button" data-featured-action="edit">Edit</button><button type="button" data-featured-action="restock">Restock</button><button type="button" data-featured-action="view">View</button></div></div>
                    </article>
                    <article class="merchant-product-card merchant-reveal" data-featured-stock="3">
                        <div class="merchant-product-card__image"><img src="~/images/menu/Roast Vegetable Focaccia.jpg" alt="Roast Vegetable Focaccia" /></div>
                        <div class="merchant-product-card__body"><div class="merchant-product-card__heading"><div><span>Fresh food</span><h3>Roast Vegetable Focaccia</h3></div><span class="merchant-badge merchant-badge--critical" data-featured-status>Restock Needed</span></div><div class="merchant-stock-line"><span><strong data-featured-count>3</strong> left</span><span>8%</span></div><div class="merchant-progress merchant-progress--critical"><span style="width:8%"></span></div><div class="merchant-card-actions"><button type="button" data-featured-action="edit">Edit</button><button type="button" data-featured-action="restock">Restock</button><button type="button" data-featured-action="view">View</button></div></div>
                    </article>
                </div>
            </section>

            <div class="merchant-split-grid">
                <section class="merchant-content-card merchant-reveal" aria-labelledby="best-sellers-title">
                    <div class="merchant-card-heading merchant-card-heading--bordered"><div><p class="merchant-kicker">Today’s best sellers</p><h2 id="best-sellers-title">Campus favourites.</h2></div></div>
                    <div class="merchant-ranking-columns">
                        <div><h3>Top drinks</h3><ol class="merchant-ranking-list"><li><span class="merchant-rank">1</span><span><strong>Latte</strong><small>56 sold</small></span><span class="merchant-rank-bar"><i style="width:100%"></i></span></li><li><span class="merchant-rank">2</span><span><strong>Flat White</strong><small>42 sold</small></span><span class="merchant-rank-bar"><i style="width:75%"></i></span></li><li><span class="merchant-rank">3</span><span><strong>Cold Brew</strong><small>35 sold</small></span><span class="merchant-rank-bar"><i style="width:63%"></i></span></li><li><span class="merchant-rank">4</span><span><strong>Long Black</strong><small>28 sold</small></span><span class="merchant-rank-bar"><i style="width:50%"></i></span></li><li><span class="merchant-rank">5</span><span><strong>Mocha</strong><small>22 sold</small></span><span class="merchant-rank-bar"><i style="width:39%"></i></span></li></ol></div>
                        <div><h3>Top food</h3><ol class="merchant-ranking-list"><li><span class="merchant-rank">1</span><span><strong>Butter Croissant</strong><small>38 sold</small></span><span class="merchant-rank-bar"><i style="width:100%"></i></span></li><li><span class="merchant-rank">2</span><span><strong>Banana Loaf</strong><small>31 sold</small></span><span class="merchant-rank-bar"><i style="width:82%"></i></span></li><li><span class="merchant-rank">3</span><span><strong>Focaccia</strong><small>25 sold</small></span><span class="merchant-rank-bar"><i style="width:66%"></i></span></li><li><span class="merchant-rank">4</span><span><strong>Garden Salad</strong><small>19 sold</small></span><span class="merchant-rank-bar"><i style="width:50%"></i></span></li><li><span class="merchant-rank">5</span><span><strong>Egg Brioche</strong><small>16 sold</small></span><span class="merchant-rank-bar"><i style="width:42%"></i></span></li></ol></div>
                    </div>
                </section>

                <section class="merchant-content-card merchant-reveal" id="merchant-notifications" aria-labelledby="notifications-title">
                    <div class="merchant-card-heading merchant-card-heading--bordered"><div><p class="merchant-kicker">Notifications</p><h2 id="notifications-title">Needs your attention.</h2></div><span class="merchant-unread-count">4 new</span></div>
                    <div class="merchant-notification-list">
                        <article><span class="merchant-notification-icon merchant-notification-icon--warning"><svg viewBox="0 0 24 24"><path d="M12 3 2 21h20L12 3Zm0 6v5m0 3v1"/></svg></span><div><strong>Low stock warning</strong><p>Roast Vegetable Focaccia has only 3 portions left.</p><time>8 minutes ago</time></div></article>
                        <article><span class="merchant-notification-icon merchant-notification-icon--coffee"><svg viewBox="0 0 24 24"><path d="M4 8h13v6a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6V8Zm13 2h2a3 3 0 0 1 0 6h-2M8 4v2m4-2v2"/></svg></span><div><strong>New catering request</strong><p>Faculty Planning Day requested service for 35 guests.</p><time>21 minutes ago</time></div></article>
                        <article><span class="merchant-notification-icon merchant-notification-icon--success"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></span><div><strong>Order completed</strong><p>Order #0998 was collected successfully.</p><time>34 minutes ago</time></div></article>
                        <article><span class="merchant-notification-icon merchant-notification-icon--feedback"><svg viewBox="0 0 24 24"><path d="M4 5h16v12H8l-4 4V5Zm4 5h8m-8 3h5"/></svg></span><div><strong>Customer feedback received</strong><p>“The flat white was perfect today.”</p><time>1 hour ago</time></div></article>
                    </div>
                </section>
            </div>

            <section class="merchant-dashboard-section" aria-labelledby="quick-actions-title">
                <div class="merchant-section-heading merchant-reveal"><div><p class="merchant-kicker">Quick actions</p><h2 id="quick-actions-title">Move the day forward.</h2></div></div>
                <div class="merchant-quick-actions">
                    <button type="button" data-dashboard-link="products"><span>+</span><strong>Add Product</strong></button>
                    <button type="button" data-dashboard-link="inventory"><span>↗</span><strong>Receive Stock</strong></button>
                    <button type="button" data-dashboard-link="catering"><span>✓</span><strong>Accept Catering</strong></button>
                    <button type="button" data-dashboard-target="overview" data-scroll-target="sales-analytics"><span>⌁</span><strong>View Reports</strong></button>
                    <button type="button" data-generate-report><span>↓</span><strong>Generate Daily Report</strong></button>
                </div>
            </section>

            <div class="merchant-split-grid merchant-split-grid--lower">
                <section class="merchant-content-card merchant-reveal" aria-labelledby="calendar-title">
                    <div class="merchant-card-heading merchant-card-heading--bordered"><div><p class="merchant-kicker">Calendar</p><h2 id="calendar-title">August 2026</h2></div><div class="merchant-calendar-controls"><button type="button" aria-label="Previous month">←</button><button type="button" aria-label="Next month">→</button></div></div>
                    <div class="merchant-calendar"><div class="merchant-calendar__weekdays"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div class="merchant-calendar__days"><span class="is-muted">27</span><span class="is-muted">28</span><span class="is-muted">29</span><span class="is-muted">30</span><span class="is-muted">31</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span class="is-today">8</span><span>9</span><span>10</span><span class="has-booking">11</span><span>12</span><span>13</span><span class="has-booking">14</span><span>15</span><span>16</span><span>17</span><span class="has-booking">18</span><span>19</span><span>20</span><span>21</span><span>22</span><span>23</span><span>24</span><span class="has-booking">25</span><span>26</span><span>27</span><span>28</span><span>29</span><span>30</span></div></div>
                    <div class="merchant-booking"><span>11:30</span><div><strong>Research Showcase</strong><small>80 guests · Atrium</small></div><span class="merchant-badge merchant-badge--accepted">Confirmed</span></div>
                </section>

                <section class="merchant-content-card merchant-reveal" aria-labelledby="performance-title">
                    <div class="merchant-card-heading merchant-card-heading--bordered"><div><p class="merchant-kicker">Performance</p><h2 id="performance-title">The details matter.</h2></div></div>
                    <div class="merchant-performance-grid">
                        <article><div class="merchant-ring" style="--progress:97"><span>97<small>%</small></span></div><strong>Customer Satisfaction</strong><small>Based on recent feedback</small></article>
                        <article><div class="merchant-ring" style="--progress:94"><span>94<small>%</small></span></div><strong>Orders Completed</strong><small>Within target time</small></article>
                        <article><div class="merchant-ring merchant-ring--sage" style="--progress:82"><span>82<small>%</small></span></div><strong>Inventory Health</strong><small>Three items need care</small></article>
                    </div>
                </section>
            </div>
        </section>

        <section class="merchant-panel" id="merchant-orders" data-dashboard-panel="orders" aria-labelledby="orders-title" hidden>
            <div class="merchant-section-heading"><div><p class="merchant-kicker">Order studio</p><h2 id="orders-title">Orders in motion.</h2></div><p>Frontend sample queue. Complete or cancel an order to preview the workflow.</p></div>
            <div class="merchant-order-grid">
                <article class="merchant-order-card" data-order-card data-order-number="#1001"><div class="merchant-order-card__heading"><div><span>Emma · 09:20</span><h3>#1001</h3></div><span class="merchant-badge merchant-badge--preparing" data-order-status>Preparing</span></div><ul><li><span>Flat White ×2</span><strong>$11.00</strong></li><li><span>Butter Croissant ×1</span><strong>$5.50</strong></li></ul><div class="merchant-order-card__total"><span>Total</span><strong>$16.50</strong></div><div class="merchant-card-actions"><button type="button" data-order-action="complete">Complete</button><button type="button" data-order-action="cancel">Cancel</button></div></article>
