<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Campus Coffee & Catering — fresh coffee, honest food and easy event catering for campus life." />
    <title>@ViewData["Title"] | Campus Coffee & Catering</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusCoffeeSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="announcement-bar">
        <p>Fresh coffee, honest food, right here on campus.</p>
        <a asp-area="" asp-controller="Home" asp-action="Catering">Planning an event? <span>Let us help</span></a>
    </div>
    <header class="site-header" data-header>
        <nav class="navbar navbar-expand-lg site-nav" aria-label="Primary navigation">
            <div class="site-shell site-nav__inner">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Campus Coffee and Catering home">
                    <span class="brand__mark" aria-hidden="true">
                        <svg viewBox="0 0 44 44" role="img"><path d="M11 16h19v9a9 9 0 0 1-9 9h-1a9 9 0 0 1-9-9v-9Z"/><path d="M30 19h2a5 5 0 0 1 0 10h-3M16 11c0-2 2-2 2-4M23 11c0-2 2-2 2-4"/></svg>
                    </span>
                    <span class="brand__text"><strong>CAMPUS</strong><small>COFFEE &amp; CATERING</small></span>
                </a>
                <button class="navbar-toggler site-nav__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav" aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span></span><span></span><span></span>
                </button>
                <div class="collapse navbar-collapse site-nav__collapse" id="primaryNav">
                    <ul class="navbar-nav site-nav__links">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Menu">Menu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="ShoppingCart">Cart</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Catering">Catering</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="OurStory">Our story</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Reviews">Reviews</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-shell site-footer__grid">
            <div class="site-footer__brand">
                <a class="brand brand--footer" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand__mark" aria-hidden="true">
                        <svg viewBox="0 0 44 44"><path d="M11 16h19v9a9 9 0 0 1-9 9h-1a9 9 0 0 1-9-9v-9Z"/><path d="M30 19h2a5 5 0 0 1 0 10h-3M16 11c0-2 2-2 2-4M23 11c0-2 2-2 2-4"/></svg>
                    </span>
                    <span class="brand__text"><strong>CAMPUS</strong><small>COFFEE &amp; CATERING</small></span>
                </a>
                <p>Good coffee and good food,<br />made for campus life.</p>
            </div>
            <div>
                <p class="site-footer__label">Explore</p>
                <a asp-area="" asp-controller="Home" asp-action="Menu">Menu</a>
                <a asp-area="" asp-controller="Home" asp-action="Catering">Catering</a>
                <a asp-area="" asp-controller="Home" asp-action="OurStory">Our story</a>
                <a asp-area="" asp-controller="Home" asp-action="Reviews">Reviews</a>
            </div>
            <div class="site-footer__contact">
                <p class="site-footer__label">Contact</p>
                <p>Phone: 09 XXX XXXX</p>
                <p>Email: campuscoffee@example.com</p>
                <nav class="site-footer__socials" aria-label="Social media">
                    <a href="#" aria-label="Facebook" data-placeholder-social>
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M16 8.05A8 8 0 1 0 6.75 16v-5.63H4.72V8.05h2.03V6.27c0-2.01 1.2-3.13 3.02-3.13.88 0 1.8.16 1.8.16v1.98h-1.02c-1 0-1.31.62-1.31 1.26v1.51h2.23l-.36 2.32H9.24V16A8 8 0 0 0 16 8.05Z"/></svg>
                    </a>
                    <a href="#" aria-label="Instagram" data-placeholder-social>
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C5.83 0 5.56.01 4.71.05 3.86.09 3.28.22 2.77.42a3.92 3.92 0 0 0-1.42.92A3.92 3.92 0 0 0 .42 2.77c-.2.51-.33 1.09-.37 1.94C.01 5.56 0 5.83 0 8s.01 2.44.05 3.29c.04.85.17 1.43.37 1.94.21.53.48.99.92 1.42.44.44.9.71 1.43.92.51.2 1.09.33 1.94.37.85.04 1.12.05 3.29.05s2.44-.01 3.29-.05c.85-.04 1.43-.17 1.94-.37a3.92 3.92 0 0 0 1.42-.92c.44-.44.71-.9.92-1.42.2-.51.33-1.09.37-1.94.04-.85.05-1.12.05-3.29s-.01-2.44-.05-3.29c-.04-.85-.17-1.43-.37-1.94a3.92 3.92 0 0 0-.92-1.42 3.92 3.92 0 0 0-1.42-.92c-.51-.2-1.09-.33-1.94-.37C10.44.01 10.17 0 8 0Zm0 1.44c2.13 0 2.38.01 3.23.05.78.03 1.2.16 1.48.27.37.14.64.32.92.6.28.28.46.55.6.92.11.28.24.7.27 1.48.04.85.05 1.1.05 3.23s-.01 2.38-.05 3.23c-.03.78-.16 1.2-.27 1.48-.14.37-.32.64-.6.92-.28.28-.55.46-.92.6-.28.11-.7.24-1.48.27-.85.04-1.1.05-3.23.05s-2.38-.01-3.23-.05c-.78-.03-1.2-.16-1.48-.27a2.48 2.48 0 0 1-.92-.6 2.48 2.48 0 0 1-.6-.92c-.11-.28-.24-.7-.27-1.48-.04-.85-.05-1.1-.05-3.23s.01-2.38.05-3.23c.03-.78.16-1.2.27-1.48.14-.37.32-.64.6-.92.28-.28.55-.46.92-.6.28-.11.7-.24 1.48-.27.85-.04 1.1-.05 3.23-.05Zm0 2.45A4.11 4.11 0 1 0 8 12.1 4.11 4.11 0 0 0 8 3.89Zm0 6.78A2.67 2.67 0 1 1 8 5.33a2.67 2.67 0 0 1 0 5.34Zm5.23-6.94a.96.96 0 1 1-1.92 0 .96.96 0 0 1 1.92 0Z"/></svg>
                    </a>
                </nav>
            </div>
            <div>
                <p class="site-footer__label">Opening hours</p>
                <p>Mon &ndash; Fri: 8:00 AM &ndash; 5:00 PM</p>
                <p>Sat &ndash; Sun: 9:00 AM &ndash; 4:00 PM</p>
            </div>
        </div>
        <div class="site-shell site-footer__bottom">
            <span>© 2026 Campus Coffee &amp; Catering</span>
            <span>Made for the campus community.</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
