@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var isIdentityArea = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Identity", StringComparison.OrdinalIgnoreCase);
    var aiRequestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var isAiUserSignedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Campus Coffee & Catering — fresh coffee, honest food and easy event catering for campus life." />
    <title>@ViewData["Title"] | Campus Coffee & Catering</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusCoffeeSystem.styles.css" asp-append-version="true" />
    <meta name="request-verification-token" content="@aiRequestToken" />
</head>
<body class="@(isIdentityArea ? "identity-area" : "")" data-ai-authenticated="@isAiUserSignedIn.ToString().ToLowerInvariant()">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="announcement-bar">
        <p>Fresh coffee, honest food, right here on campus.</p>
        <a asp-area="" asp-controller="Home" asp-action="Catering">Planning an event? <span>Let us help</span></a>
    </div>
    <header class="site-header" data-header>
        <nav class="navbar navbar-expand-lg site-nav" aria-label="Primary navigation">
            <div class="site-shell site-nav__inner">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Campus Coffee and Catering home">
                    <span class="brand__mark" aria-hidden="true">
                        <svg viewBox="0 0 44 44" role="img"><path d="M11 16h19v9a9 9 0 0 1-9 9h-1a9 9 0 0 1-9-9v-9Z"/><path d="M30 19h2a5 5 0 0 1 0 10h-3M16 11c0-2 2-2 2-4M23 11c0-2 2-2 2-4"/></svg>
                    </span>
                    <span class="brand__text"><strong>CAMPUS</strong><small>COFFEE &amp; CATERING</small></span>
                </a>
                <button class="navbar-toggler site-nav__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav" aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span></span><span></span><span></span>
                </button>
                <div class="collapse navbar-collapse site-nav__collapse" id="primaryNav">
                    <ul class="navbar-nav site-nav__links">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Menu">Menu</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="ShoppingCart">Cart</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Catering">Catering</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="OurStory">Our story</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-shell site-footer__grid">
            <div class="site-footer__brand">
                <a class="brand brand--footer" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand__mark" aria-hidden="true">
                        <svg viewBox="0 0 44 44"><path d="M11 16h19v9a9 9 0 0 1-9 9h-1a9 9 0 0 1-9-9v-9Z"/><path d="M30 19h2a5 5 0 0 1 0 10h-3M16 11c0-2 2-2 2-4M23 11c0-2 2-2 2-4"/></svg>
                    </span>
                    <span class="brand__text"><strong>CAMPUS</strong><small>COFFEE &amp; CATERING</small></span>
                </a>
                <p>Good coffee and good food,<br />made for campus life.</p>
            </div>
            <div>
                <p class="site-footer__label">Explore</p>
                <a asp-area="" asp-controller="Home" asp-action="Menu">Menu</a>
                <a asp-area="" asp-controller="Home" asp-action="Catering">Catering</a>
                <a asp-area="" asp-controller="Home" asp-action="OurStory">Our story</a>
            </div>
            <div>
                <p class="site-footer__label">Your account</p>
                <a asp-area="" asp-controller="Home" asp-action="Portal">Sign in</a>
                <a asp-area="" asp-controller="Home" asp-action="CustomerRegister">Create account</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
            <div>
                <p class="site-footer__label">Opening hours</p>
                <p>Open weekdays during semester.<br />Hours may vary during breaks.</p>
            </div>
        </div>
        <div class="site-shell site-footer__bottom">
            <span>© 2026 Campus Coffee &amp; Catering</span>
            <span>Made for the campus community.</span>
        </div>
    </footer>
    @if (isAiUserSignedIn)
    {
        <aside class="coffee-agency" data-coffee-agency aria-label="Coffee agency assistant">
            <button class="coffee-agency__launcher" type="button" data-ai-toggle aria-expanded="false" aria-controls="coffee-agency-panel">
                <span aria-hidden="true">✦</span>
                <span>Contract your coffee agency</span>
            </button>
            <section class="coffee-agency__panel" id="coffee-agency-panel" data-ai-panel hidden aria-label="Coffee agency chat">
                <header class="coffee-agency__header">
                    <div>
                        <p>Campus Coffee</p>
                        <h2>Your coffee agency</h2>
                    </div>
                    <button type="button" class="coffee-agency__close" data-ai-close aria-label="Close chat">×</button>
                </header>
                <div class="coffee-agency__messages" data-ai-messages aria-live="polite">
                    <p class="coffee-agency__intro">Hello. I can help you discover menu favourites, explain the ordering flow, or find a good match for your day.</p>
                </div>
                <form class="coffee-agency__form" data-ai-chat-form>
                    <label class="visually-hidden" for="coffee-agency-message">Ask your coffee agency</label>
                    <textarea id="coffee-agency-message" data-ai-message maxlength="800" placeholder="Ask about coffee, food or ordering" required></textarea>
                    <button class="button product-card__button" type="submit" data-ai-send>Send</button>
                </form>
            </section>
        </aside>
    }
    else
    {
        <a class="coffee-agency__launcher coffee-agency__launcher--guest" asp-area="" asp-controller="Home" asp-action="Portal">Contract your coffee agency</a>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/coffee-agency.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
