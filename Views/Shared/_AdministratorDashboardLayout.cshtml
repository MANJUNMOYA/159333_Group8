<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Campus Coffee administrator management portal." />
    <title>@ViewData["Title"] | Campus Coffee &amp; Catering</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/administrator-dashboard.css" asp-append-version="true" />
</head>
<body class="administrator-dashboard-page">
    <a class="skip-link" href="#administrator-main">Skip to administrator content</a>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
