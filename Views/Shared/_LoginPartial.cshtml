@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav site-nav__account">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link account-link" asp-area="" asp-controller="Home" asp-action="CustomerDashboard" title="Manage account">@User.Identity?.Name</a>
    </li>
    <li class="nav-item">
        <form class="account-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link account-link">Sign out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="button button--nav" asp-area="" asp-controller="Home" asp-action="Portal">Access Portal</a>
    </li>
}
</ul>
